---
// Clay-style "3D" illustrations of İzmir symbols, drawn as inline SVG so they stay sharp and light.
interface Props {
  name: 'saatkulesi' | 'asansor' | 'vapur' | 'marti' | 'palmiye' | 'metro' | 'bilet' | 'harita' | 'nota' | 'maske' | 'otobus';
  size?: number;
  class?: string;
}
const { name, size = 120, class: cls } = Astro.props;
// Gradient ids must be unique per instance: when one copy sits in a hidden (display:none) block,
// other copies that point at its <defs> would lose their fills.
const g = globalThis as { __izmirIconSeq?: number };
g.__izmirIconSeq = (g.__izmirIconSeq ?? 0) + 1;
const id = `ii-${name}-${g.__izmirIconSeq}`;
---

<svg
  class={cls}
  width={size}
  height={size}
  viewBox="0 0 120 120"
  fill="none"
  aria-hidden="true"
  xmlns="http://www.w3.org/2000/svg"
>
  <defs>
    <radialGradient id={`${id}-sh`} cx="50%" cy="50%" r="50%">
      <stop offset="0" stop-color="#5a3a1a" stop-opacity=".28" />
      <stop offset="1" stop-color="#5a3a1a" stop-opacity="0" />
    </radialGradient>
  </defs>

  {name === 'saatkulesi' && (
    <g>
      <defs>
        <linearGradient id={`${id}-st`} x1="0" y1="0" x2="1" y2="1">
          <stop offset="0" stop-color="#fff1d6" /><stop offset="1" stop-color="#e7bd85" />
        </linearGradient>
        <linearGradient id={`${id}-sd`} x1="0" y1="0" x2="1" y2="1">
          <stop offset="0" stop-color="#d9a56a" /><stop offset="1" stop-color="#b47a43" />
        </linearGradient>
        <linearGradient id={`${id}-dm`} x1="0" y1="0" x2="1" y2="1">
          <stop offset="0" stop-color="#4f7be8" /><stop offset="1" stop-color="#062f96" />
        </linearGradient>
      </defs>
      <ellipse cx="60" cy="110" rx="34" ry="6" fill={`url(#${id}-sh)`} />
      <rect x="26" y="96" width="62" height="12" rx="3" fill={`url(#${id}-st)`} />
      <rect x="88" y="96" width="8" height="12" rx="2" fill={`url(#${id}-sd)`} />
      <rect x="36" y="58" width="42" height="40" rx="3" fill={`url(#${id}-st)`} />
      <rect x="78" y="58" width="9" height="40" rx="2" fill={`url(#${id}-sd)`} />
      <path d="M50 98V82a7 7 0 0 1 14 0v16z" fill="#b47a43" opacity=".55" />
      <rect x="32" y="54" width="54" height="6" rx="3" fill="#ff8c2b" />
      <rect x="40" y="30" width="34" height="26" rx="3" fill={`url(#${id}-st)`} />
      <rect x="74" y="30" width="8" height="26" rx="2" fill={`url(#${id}-sd)`} />
      <circle cx="57" cy="43" r="9.5" fill="#fff" stroke="#e1b47c" stroke-width="2" />
      <path d="M57 43v-6M57 43l4 2.5" stroke="#062f96" stroke-width="2" stroke-linecap="round" />
      <rect x="36" y="26" width="50" height="5" rx="2.5" fill="#ff8c2b" />
      <path d="M42 26c0-9 7-15 18-15s18 6 18 15z" fill={`url(#${id}-dm)`} />
      <path d="M48 22c2-5 6-8 11-8" stroke="#fff" stroke-opacity=".5" stroke-width="2.5" stroke-linecap="round" />
      <path d="M60 11V4" stroke="#062f96" stroke-width="2.5" stroke-linecap="round" />
      <circle cx="60" cy="4" r="2.6" fill="#ff8c2b" />
      <path d="M40 62v32" stroke="#fff" stroke-opacity=".7" stroke-width="2.5" stroke-linecap="round" />
    </g>
  )}

  {name === 'asansor' && (
    <g>
      <defs>
        <linearGradient id={`${id}-br`} x1="0" y1="0" x2="1" y2="1">
          <stop offset="0" stop-color="#f08a5d" /><stop offset="1" stop-color="#c4512b" />
        </linearGradient>
        <linearGradient id={`${id}-bs`} x1="0" y1="0" x2="1" y2="1">
          <stop offset="0" stop-color="#b64624" /><stop offset="1" stop-color="#8a3016" />
        </linearGradient>
      </defs>
      <ellipse cx="52" cy="111" rx="26" ry="5" fill={`url(#${id}-sh)`} />
      <rect x="34" y="28" width="30" height="80" rx="3" fill={`url(#${id}-br)`} />
      <rect x="64" y="28" width="9" height="80" rx="2" fill={`url(#${id}-bs)`} />
      {[40, 54, 68, 82].map((y) => (
        <rect x="42" y={y} width="14" height="8" rx="4" fill="#7a2a12" opacity=".35" />
      ))}
      <path d="M48 108V96a6 6 0 0 1 12 0v12" fill="#7a2a12" opacity=".45" />
      <rect x="30" y="14" width="40" height="16" rx="4" fill="#fff1d6" />
      <rect x="70" y="14" width="8" height="16" rx="2" fill="#e1b47c" />
      <rect x="35" y="18" width="7" height="8" rx="2" fill="#4f7be8" />
      <rect x="46" y="18" width="7" height="8" rx="2" fill="#4f7be8" />
      <rect x="57" y="18" width="7" height="8" rx="2" fill="#4f7be8" />
      <rect x="27" y="10" width="54" height="5" rx="2.5" fill="#062f96" />
      <rect x="78" y="22" width="30" height="7" rx="3" fill="#e1b47c" />
      <path d="M80 22v-6M92 22v-6M104 22v-6M78 16h30" stroke="#062f96" stroke-width="2" stroke-linecap="round" />
      <path d="M38 34v66" stroke="#fff" stroke-opacity=".45" stroke-width="2.5" stroke-linecap="round" />
    </g>
  )}

  {name === 'vapur' && (
    <g>
      <defs>
        <linearGradient id={`${id}-hl`} x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#ffffff" /><stop offset="1" stop-color="#dfe6f5" />
        </linearGradient>
        <linearGradient id={`${id}-ch`} x1="0" y1="0" x2="1" y2="1">
          <stop offset="0" stop-color="#ffab5e" /><stop offset="1" stop-color="#ef6a00" />
        </linearGradient>
        <linearGradient id={`${id}-wv`} x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#6c95f0" /><stop offset="1" stop-color="#1d4fc4" />
        </linearGradient>
      </defs>
      <rect x="66" y="30" width="11" height="22" rx="3" fill={`url(#${id}-ch)`} />
      <rect x="66" y="34" width="11" height="4" fill="#062f96" />
      <path d="M30 52h60l-4 14H34z" fill={`url(#${id}-hl)`} />
      <rect x="38" y="44" width="40" height="10" rx="3" fill="#fff" />
      {[42, 52, 62].map((x) => <rect x={x} y="47" width="7" height="4" rx="1.5" fill="#4f7be8" />)}
      <path d="M14 64h92l-10 20a6 6 0 0 1-5 3H29a6 6 0 0 1-5-3z" fill={`url(#${id}-hl)`} />
      <path d="M17 70h86l-2.5 5H19.5z" fill="#062f96" />
      {[30, 42, 54, 66, 78].map((x) => <circle cx={x} cy="80" r="2.4" fill="#4f7be8" />)}
      <path d="M8 94c8-6 14-6 22 0s14 6 22 0 14-6 22 0 14 6 22 0 10-5 16-2v16H8z" fill={`url(#${id}-wv)`} />
      <path d="M14 96c5-3 9-3 14 0" stroke="#fff" stroke-opacity=".6" stroke-width="2.5" stroke-linecap="round" />
      <path d="M62 96c5-3 9-3 14 0" stroke="#fff" stroke-opacity=".6" stroke-width="2.5" stroke-linecap="round" />
    </g>
  )}

  {name === 'marti' && (
    <g>
      <defs>
        <linearGradient id={`${id}-wg`} x1="0" y1="0" x2="1" y2="1">
          <stop offset="0" stop-color="#ffffff" /><stop offset="1" stop-color="#cfd8ea" />
        </linearGradient>
      </defs>
      <path d="M58 66C46 46 30 40 12 44c14 4 26 12 34 26z" fill={`url(#${id}-wg)`} />
      <path d="M12 44c6 1 11 3 16 6" stroke="#7d8aa6" stroke-width="3" stroke-linecap="round" />
      <path d="M62 66c10-22 26-30 46-28-14 5-26 14-32 30z" fill={`url(#${id}-wg)`} />
      <path d="M108 38c-6 1-11 3-16 7" stroke="#7d8aa6" stroke-width="3" stroke-linecap="round" />
      <ellipse cx="60" cy="72" rx="20" ry="10" fill="#fff" />
      <circle cx="78" cy="66" r="7" fill="#fff" />
      <circle cx="80" cy="65" r="1.6" fill="#1a1a1a" />
      <path d="M84 66l8 2-8 2z" fill="#ff8c2b" />
      <path d="M40 74l-8 4 9 0z" fill="#cfd8ea" />
    </g>
  )}

  {name === 'palmiye' && (
    <g>
      <defs>
        <linearGradient id={`${id}-tr`} x1="0" y1="0" x2="1" y2="0">
          <stop offset="0" stop-color="#d9a56a" /><stop offset="1" stop-color="#9c6532" />
        </linearGradient>
        <linearGradient id={`${id}-lf`} x1="0" y1="0" x2="1" y2="1">
          <stop offset="0" stop-color="#7fd38a" /><stop offset="1" stop-color="#2e8b4a" />
        </linearGradient>
      </defs>
      <ellipse cx="62" cy="111" rx="22" ry="5" fill={`url(#${id}-sh)`} />
      <path d="M56 108c2-26 0-48 6-72h7c-5 24-3 46-3 72z" fill={`url(#${id}-tr)`} />
      {[50, 62, 74, 86, 98].map((y) => <path d={`M${57 + (108 - y) * 0.08} ${y}h9`} stroke="#8a5428" stroke-opacity=".4" stroke-width="2" />)}
      <path d="M65 36C52 24 36 24 22 34c14-2 28 2 43 6z" fill={`url(#${id}-lf)`} />
      <path d="M65 36c10-14 26-18 40-12-14 1-26 6-37 16z" fill={`url(#${id}-lf)`} />
      <path d="M65 36C58 50 46 58 32 60c10-8 20-16 31-26z" fill={`url(#${id}-lf)`} />
      <path d="M66 36c12 6 20 18 22 32-8-10-15-19-25-28z" fill={`url(#${id}-lf)`} />
      <path d="M65 36c-2-12 2-24 12-30-4 10-6 20-9 31z" fill={`url(#${id}-lf)`} />
      <circle cx="62" cy="40" r="4" fill="#8a5428" /><circle cx="69" cy="41" r="4" fill="#9c6532" />
    </g>
  )}

  {name === 'metro' && (
    <g>
      <defs>
        <linearGradient id={`${id}-bd`} x1="0" y1="0" x2="1" y2="1">
          <stop offset="0" stop-color="#ffffff" /><stop offset="1" stop-color="#d6deef" />
        </linearGradient>
        <linearGradient id={`${id}-gl`} x1="0" y1="0" x2="1" y2="1">
          <stop offset="0" stop-color="#4f7be8" /><stop offset="1" stop-color="#062f96" />
        </linearGradient>
      </defs>
      <ellipse cx="60" cy="110" rx="34" ry="5" fill={`url(#${id}-sh)`} />
      <rect x="28" y="16" width="64" height="80" rx="16" fill={`url(#${id}-bd)`} />
      <rect x="92" y="24" width="6" height="66" rx="3" fill="#b9c4dd" />
      <rect x="36" y="26" width="48" height="34" rx="8" fill={`url(#${id}-gl)`} />
      <path d="M42 32l12 0-14 20z" fill="#fff" opacity=".35" />
      <rect x="28" y="66" width="64" height="8" fill="#ff8c2b" />
      <circle cx="42" cy="84" r="5" fill="#ffd27a" /><circle cx="78" cy="84" r="5" fill="#ffd27a" />
      <rect x="52" y="81" width="16" height="5" rx="2.5" fill="#b9c4dd" />
      <path d="M40 96l-8 12M80 96l8 12" stroke="#7d8aa6" stroke-width="4" stroke-linecap="round" />
      <path d="M26 106h68" stroke="#7d8aa6" stroke-width="3" stroke-linecap="round" />
    </g>
  )}

  {name === 'bilet' && (
    <g>
      <defs>
        <linearGradient id={`${id}-tk`} x1="0" y1="0" x2="1" y2="1">
          <stop offset="0" stop-color="#ffb26b" /><stop offset="1" stop-color="#ef6a00" />
        </linearGradient>
      </defs>
      <ellipse cx="62" cy="106" rx="36" ry="6" fill={`url(#${id}-sh)`} />
      <g transform="rotate(-12 60 60)">
        <path d="M18 36h84v14a10 10 0 0 0 0 20v14H18V70a10 10 0 0 0 0-20z" fill="#c95500" transform="translate(4 5)" />
        <path d="M18 36h84v14a10 10 0 0 0 0 20v14H18V70a10 10 0 0 0 0-20z" fill={`url(#${id}-tk)`} />
        <path d="M78 40v40" stroke="#fff" stroke-opacity=".6" stroke-width="2.5" stroke-dasharray="4 5" />
        <path d="M48 46l4.4 9 9.8 1.4-7.1 6.9 1.7 9.8-8.8-4.6-8.8 4.6 1.7-9.8-7.1-6.9 9.8-1.4z" fill="#fff" />
        <path d="M24 42h40" stroke="#fff" stroke-opacity=".45" stroke-width="2.5" stroke-linecap="round" />
      </g>
    </g>
  )}

  {name === 'harita' && (
    <g>
      <defs>
        <linearGradient id={`${id}-mp`} x1="0" y1="0" x2="1" y2="1">
          <stop offset="0" stop-color="#fff6e8" /><stop offset="1" stop-color="#eed3ad" />
        </linearGradient>
        <linearGradient id={`${id}-pn`} x1="0" y1="0" x2="1" y2="1">
          <stop offset="0" stop-color="#4f7be8" /><stop offset="1" stop-color="#062f96" />
        </linearGradient>
      </defs>
      <ellipse cx="60" cy="108" rx="40" ry="6" fill={`url(#${id}-sh)`} />
      <path d="M14 50l30-10 32 10 30-10v52l-30 10-32-10-30 10z" fill={`url(#${id}-mp)`} />
      <path d="M44 40v52M76 50v52" stroke="#d9b583" stroke-width="2" />
      <path d="M22 80c10-6 18 4 28-2s16-10 26-4 16 2 22-2" stroke="#ff8c2b" stroke-width="3" stroke-linecap="round" stroke-dasharray="1 7" />
      <path d="M60 74C48 60 42 50 42 40a18 18 0 0 1 36 0c0 10-6 20-18 34z" fill={`url(#${id}-pn)`} />
      <circle cx="60" cy="40" r="7" fill="#fff" />
      <path d="M50 30c2-4 6-6 10-6" stroke="#fff" stroke-opacity=".5" stroke-width="2.5" stroke-linecap="round" />
    </g>
  )}
  {name === 'nota' && (
    <g>
      <defs>
        <linearGradient id={`${id}-nt`} x1="0" y1="0" x2="1" y2="1">
          <stop offset="0" stop-color="#6f95f2" /><stop offset="1" stop-color="#062f96" />
        </linearGradient>
      </defs>
      <ellipse cx="58" cy="110" rx="32" ry="5" fill={`url(#${id}-sh)`} />
      <path d="M44 30l50-14v62" stroke="#041e6e" stroke-width="9" stroke-linecap="round" stroke-linejoin="round" transform="translate(2 3)" opacity=".35" />
      <path d="M44 84V30l50-14v62" stroke={`url(#${id}-nt)`} stroke-width="9" stroke-linecap="round" stroke-linejoin="round" />
      <path d="M44 30l50-14v12l-50 14z" fill={`url(#${id}-nt)`} />
      <ellipse cx="33" cy="86" rx="15" ry="12" fill={`url(#${id}-nt)`} transform="rotate(-18 33 86)" />
      <ellipse cx="83" cy="80" rx="15" ry="12" fill={`url(#${id}-nt)`} transform="rotate(-18 83 80)" />
      <path d="M24 82c2-4 6-6 10-6M74 76c2-4 6-6 10-6" stroke="#fff" stroke-opacity=".55" stroke-width="3" stroke-linecap="round" />
    </g>
  )}

  {name === 'maske' && (
    <g>
      <defs>
        <linearGradient id={`${id}-m1`} x1="0" y1="0" x2="1" y2="1">
          <stop offset="0" stop-color="#ffd27a" /><stop offset="1" stop-color="#ef8a00" />
        </linearGradient>
        <linearGradient id={`${id}-m2`} x1="0" y1="0" x2="1" y2="1">
          <stop offset="0" stop-color="#ff8fb4" /><stop offset="1" stop-color="#c2255c" />
        </linearGradient>
      </defs>
      <ellipse cx="60" cy="110" rx="36" ry="5" fill={`url(#${id}-sh)`} />
      <g transform="rotate(14 78 58)">
        <path d="M58 26h42v30c0 18-9 32-21 32S58 74 58 56z" fill={`url(#${id}-m2)`} />
        <path d="M66 46q4-4 8 0M84 46q4-4 8 0" stroke="#5c0f2b" stroke-width="3.5" stroke-linecap="round" fill="none" />
        <path d="M68 72q11-9 22 0" stroke="#5c0f2b" stroke-width="3.5" stroke-linecap="round" fill="none" />
      </g>
      <g transform="rotate(-12 42 56)">
        <path d="M20 24h44v32c0 19-10 34-22 34S20 75 20 56z" fill={`url(#${id}-m1)`} />
        <ellipse cx="32" cy="46" rx="4.5" ry="3.5" fill="#6b3a00" />
        <ellipse cx="52" cy="46" rx="4.5" ry="3.5" fill="#6b3a00" />
        <path d="M30 64q12 11 24 0" stroke="#6b3a00" stroke-width="3.5" stroke-linecap="round" fill="none" />
        <path d="M26 30c0 8 0 16 2 22" stroke="#fff" stroke-opacity=".55" stroke-width="3" stroke-linecap="round" />
      </g>
    </g>
  )}
  {name === 'otobus' && (
    <g>
      <defs>
        <linearGradient id={`${id}-ob`} x1="0" y1="0" x2="1" y2="1">
          <stop offset="0" stop-color="#ffb26b" /><stop offset="1" stop-color="#ef6a00" />
        </linearGradient>
        <linearGradient id={`${id}-og`} x1="0" y1="0" x2="1" y2="1">
          <stop offset="0" stop-color="#cfe0ff" /><stop offset="1" stop-color="#7fa2ee" />
        </linearGradient>
      </defs>
      <ellipse cx="60" cy="110" rx="36" ry="5" fill={`url(#${id}-sh)`} />
      <rect x="92" y="22" width="7" height="72" rx="3" fill="#c95500" />
      <rect x="24" y="16" width="70" height="82" rx="14" fill={`url(#${id}-ob)`} />
      <rect x="34" y="22" width="50" height="8" rx="4" fill="#062f96" />
      <rect x="31" y="34" width="56" height="30" rx="6" fill={`url(#${id}-og)`} />
      <path d="M36 38h14l-12 20z" fill="#fff" opacity=".45" />
      <rect x="24" y="70" width="70" height="6" fill="#fff" opacity=".85" />
      <circle cx="38" cy="86" r="5" fill="#fff4cc" /><circle cx="80" cy="86" r="5" fill="#fff4cc" />
      <rect x="50" y="83" width="18" height="6" rx="3" fill="#c95500" />
      <rect x="30" y="96" width="12" height="10" rx="3" fill="#1a1a1a" /><rect x="76" y="96" width="12" height="10" rx="3" fill="#1a1a1a" />
      <path d="M30 22c0-2 2-4 4-4" stroke="#fff" stroke-opacity=".6" stroke-width="3" stroke-linecap="round" />
    </g>
