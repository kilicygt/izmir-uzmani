---
// The big İzmir island illustration (Saat Kulesi, Asansör, palmiye, vapur, martılar).
import IzmirIcon from './IzmirIcon.astro';
---

<div class="scene" aria-hidden="true">
  <div class="scene-sun"></div>
  <div class="scene-sea"></div>
  <div class="scene-land"></div>
  <IzmirIcon name="asansor" size={150} class="sc sc-asansor" />
  <IzmirIcon name="saatkulesi" size={220} class="sc sc-kule" />
  <IzmirIcon name="palmiye" size={130} class="sc sc-palm" />
  <IzmirIcon name="marti" size={84} class="sc sc-marti" />
  <IzmirIcon name="marti" size={54} class="sc sc-marti2" />
  <IzmirIcon name="vapur" size={170} class="sc sc-vapur" />
</div>

<style>
  .scene { position: relative; height: clamp(300px, 40vw, 460px); max-width: 520px; width: 100%; margin: 0 auto; }
  .scene-sun {
    position: absolute; top: 6%; right: 10%; width: 26%; aspect-ratio: 1; border-radius: 50%;
    background: radial-gradient(circle at 35% 35%, #ffd08a, #ff8c2b 70%);
    box-shadow: 0 0 60px rgba(255,140,43,0.45);
  }
  .scene-sea {
    position: absolute; left: 6%; right: 6%; bottom: 6%; height: 58%; border-radius: 50% 50% 46% 46%;
    background: linear-gradient(180deg, #8fb0f5 0%, #3f6fdc 100%);
    box-shadow: inset 0 -18px 40px rgba(6,47,150,0.25), 0 30px 60px -30px rgba(6,47,150,0.45);
  }
  .scene-land {
    position: absolute; left: 12%; right: 12%; bottom: 25%; height: 26%; border-radius: 50%;
    background: linear-gradient(180deg, #fbe7c8 0%, #ecc993 100%);
    box-shadow: 0 10px 0 #d9ad6e, 0 22px 30px -10px rgba(6,47,150,0.4);
  }
  .scene :global(.sc) { position: absolute; height: auto; filter: drop-shadow(0 18px 18px rgba(90,58,26,0.18)); }
  .scene :global(.sc-kule) { left: 35%; bottom: 27%; width: 42%; animation: scBob 6s ease-in-out infinite; }
  .scene :global(.sc-asansor) { left: 9%; bottom: 31%; width: 28%; animation: scBob 7s ease-in-out infinite 0.6s; }
  .scene :global(.sc-palm) { right: 9%; bottom: 31%; width: 25%; animation: scBob 6.5s ease-in-out infinite 1.2s; }
  .scene :global(.sc-vapur) { right: 30%; bottom: 2%; width: 34%; animation: scSail 8s ease-in-out infinite; }
  .scene :global(.sc-marti) { left: 14%; top: 6%; width: 17%; animation: scFly 9s ease-in-out infinite; }
  .scene :global(.sc-marti2) { left: 40%; top: 0; width: 11%; animation: scFly 11s ease-in-out infinite 1s; }
  @keyframes scBob { 0%,100% { transform: translateY(0); } 50% { transform: translateY(-8px); } }
  @keyframes scSail { 0%,100% { transform: translate(0,0) rotate(0); } 50% { transform: translate(-10px,-4px) rotate(-2deg); } }
  @keyframes scFly { 0%,100% { transform: translate(0,0); } 50% { transform: translate(18px,-10px); } }
  @media (prefers-reduced-motion: reduce) { .scene :global(.sc) { animation: none !important; } }
</style>
