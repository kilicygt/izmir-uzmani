---
// Text logo in the brand colours (logo blue #062F96, wave orange #FF7C10, cream #FFF9F3).
interface Props { variant?: 'dalga' | 'rozet' | 'kapsul'; }
const { variant = 'dalga' } = Astro.props;
const wave = 'M1 7c3.5-5 7-5 10.5 0s7 5 10.5 0 7-5 10.5 0 7 5 10.5 0 7-5 10.5 0';
---

{variant === 'dalga' && (
  <span class="wm wm-dalga">
    <span class="wm-line"><span class="wm-izmir">İzmir</span><span class="wm-uzmani">Uzmanı</span></span>
    <svg class="wm-wave" viewBox="0 0 54 10" preserveAspectRatio="none" aria-hidden="true"><path d={wave} fill="none" stroke="#FF7C10" stroke-width="2.2" stroke-linecap="round" /></svg>
  </span>
)}

{variant === 'rozet' && (
  <span class="wm wm-rozet">
    <span class="wm-badge" aria-hidden="true">
      <span class="wm-badge-i">İ</span>
      <svg class="wm-badge-wave" viewBox="0 0 54 10" aria-hidden="true"><path d={wave} fill="none" stroke="#FF7C10" stroke-width="3" stroke-linecap="round" /></svg>
    </span>
    <span class="wm-stack">
      <span class="wm-izmir">İzmir</span>
      <span class="wm-uzmani">Uzmanı</span>
    </span>
  </span>
)}

{variant === 'kapsul' && (
  <span class="wm wm-kapsul">
    <span class="wm-izmir">İzmir</span><span class="wm-uzmani">Uzmanı</span>
    <svg class="wm-wave" viewBox="0 0 54 10" preserveAspectRatio="none" aria-hidden="true"><path d={wave} fill="none" stroke="#FF7C10" stroke-width="2.4" stroke-linecap="round" /></svg>
  </span>
)}

<style>
  .wm { display: inline-flex; font-family: 'Fraunces', serif; font-weight: 800; letter-spacing: -0.02em; line-height: 1; white-space: nowrap; }

  /* 1: yazı + dalga */
  .wm-dalga { flex-direction: column; align-items: flex-start; gap: 3px; }
  .wm-dalga .wm-line { font-size: 25px; }
  .wm-dalga .wm-izmir { color: #062F96; }
  .wm-dalga .wm-uzmani { color: #FF7C10; margin-left: 5px; }
  .wm-dalga .wm-wave { width: 62px; height: 8px; margin-left: 1px; }

  /* 2: rozet + iki satır */
  .wm-rozet { align-items: center; gap: 10px; }
  .wm-badge { width: 42px; height: 42px; border-radius: 13px; background: #062F96; display: inline-flex; flex-direction: column; align-items: center; justify-content: center; gap: 1px; box-shadow: 0 8px 18px -10px rgba(6,47,150,0.8); }
  .wm-badge-i { color: #FFF9F3; font-size: 24px; line-height: 0.9; margin-top: 3px; }
  .wm-badge-wave { width: 24px; height: 6px; }
  .wm-stack { display: flex; flex-direction: column; gap: 1px; }
  .wm-rozet .wm-izmir { color: #062F96; font-size: 21px; }
  .wm-rozet .wm-uzmani { color: #FF7C10; font-size: 14px; font-family: 'Poppins', sans-serif; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; }

  /* 3: mavi kapsül, krem yazı */
  .wm-kapsul { position: relative; align-items: center; background: #062F96; color: #FFF9F3; font-size: 20px; padding: 9px 16px 13px; border-radius: 14px; box-shadow: 0 10px 22px -12px rgba(6,47,150,0.85); }
  .wm-kapsul .wm-uzmani { margin-left: 5px; color: #FFD9B0; }
  .wm-kapsul .wm-wave { position: absolute; left: 16px; bottom: 5px; width: 56px; height: 7px; }

  @media (max-width: 380px) {
    .wm-dalga .wm-line { font-size: 22px; }
    .wm-kapsul { font-size: 18px; }
  }
</style>
