---
// Text logo in the brand colours: logo blue #062F96, wave orange #FF7C10, cream #FFF9F3.
interface Props {
  /** "dark" for dark backgrounds such as the footer. */
  tone?: 'light' | 'dark';
}
const { tone = 'light' } = Astro.props;
const wave = 'M1 7c3.5-5 7-5 10.5 0s7 5 10.5 0 7-5 10.5 0 7 5 10.5 0 7-5 10.5 0';
---

<span class:list={['wm', { 'wm-dark': tone === 'dark' }]}>
  <span class="wm-badge" aria-hidden="true">
    <span class="wm-badge-i">İ</span>
    <svg class="wm-badge-wave" viewBox="0 0 54 10"><path d={wave} fill="none" stroke="#FF7C10" stroke-width="3" stroke-linecap="round" /></svg>
  </span>
  <span class="wm-stack">
    <span class="wm-izmir">İzmir</span>
    <span class="wm-uzmani">Uzmanı</span>
  </span>
</span>

<style>
  .wm { display: inline-flex; align-items: center; gap: 10px; white-space: nowrap; }
  .wm-badge {
    width: 42px; height: 42px; border-radius: 13px; background: #062F96;
    display: inline-flex; flex-direction: column; align-items: center; justify-content: center; gap: 1px;
    box-shadow: 0 8px 18px -10px rgba(6,47,150,0.8);
  }
  .wm-badge-i { font-family: 'Fraunces', serif; font-weight: 800; color: #FFF9F3; font-size: 24px; line-height: 0.9; margin-top: 3px; }
  .wm-badge-wave { width: 24px; height: 6px; }
  .wm-stack { display: flex; flex-direction: column; gap: 1px; line-height: 1; }
  .wm-izmir { font-family: 'Fraunces', serif; font-weight: 800; letter-spacing: -0.02em; color: #062F96; font-size: 21px; }
  .wm-dark .wm-badge { box-shadow: 0 0 0 2px #FFF9F3, 0 8px 18px -10px rgba(0,0,0,0.6); }
  .wm-dark .wm-izmir { color: #FFF9F3; }
  .wm-uzmani { font-family: 'Poppins', sans-serif; font-weight: 600; font-size: 14px; letter-spacing: 0.14em; text-transform: uppercase; color: #FF7C10; }
</style>
