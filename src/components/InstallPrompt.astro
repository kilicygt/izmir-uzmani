---
// "Ana ekrana ekle" card: Chrome/Android get the native install prompt, iPhone Safari gets instructions.
// Shown at most once a month, never inside the installed app, and only after the cookie choice is made.
---

<div id="install-card" class="ic" role="dialog" aria-label="Uygulamayı yükle" hidden>
  <img src="/icons/icon-192.png" alt="" width="52" height="52" class="ic-icon" />
  <div class="ic-text">
    <p class="ic-title">İzmir Uzmanı’nı ana ekrana ekle</p>
    <p class="ic-desc" data-ic-android>Saatler ve nöbetçi eczaneler tek dokunuşla, internet zayıfken bile.</p>
    <p class="ic-desc" data-ic-ios hidden>
      Alttaki <svg class="ic-share" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-label="Paylaş"><path d="M12 3v12M7 8l5-5 5 5"/><path d="M5 12v7a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-7"/></svg> <strong>Paylaş</strong> simgesine, sonra <strong>“Ana Ekrana Ekle”</strong>ye dokun.
    </p>
  </div>
  <div class="ic-actions">
    <button type="button" class="ic-btn" data-ic-install>Yükle</button>
    <button type="button" class="ic-close" data-ic-close aria-label="Kapat">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg>
    </button>
  </div>
</div>

<style>
  .ic {
    position: fixed; left: 12px; right: 12px; bottom: 12px; z-index: 150; max-width: 460px; margin: 0 auto;
    display: flex; align-items: center; gap: 12px; padding: 12px 12px 12px 12px;
    background: #fff; border: 1px solid #efe2d3; border-radius: 20px; box-shadow: 0 24px 50px -20px rgba(15,20,40,0.45);
    animation: icUp 0.35s cubic-bezier(.2,.8,.2,1) both;
  }
  .ic[hidden] { display: none; }
  @keyframes icUp { from { transform: translateY(120%); opacity: 0; } to { transform: none; opacity: 1; } }
  .ic-icon { width: 52px; height: 52px; border-radius: 14px; flex-shrink: 0; }
  .ic-text { flex: 1; min-width: 0; }
  .ic-title { font-size: 14.5px; font-weight: 600; color: #1a1a1a; line-height: 1.3; }
  .ic-desc { font-size: 12.5px; color: #666; line-height: 1.45; margin-top: 2px; }
  .ic-desc[hidden], .ic-btn[hidden] { display: none; }
  .ic-share { vertical-align: -3px; color: #062f96; }
  .ic-actions { display: flex; align-items: center; gap: 4px; flex-shrink: 0; }
  .ic-btn { font: 600 14px 'Poppins', sans-serif; color: #fff; background: #062f96; border: 0; border-radius: 12px; padding: 10px 16px; cursor: pointer; }
  .ic-btn:hover { background: #041e6e; }
  .ic-close { width: 34px; height: 34px; border-radius: 50%; border: 0; background: #f0e6da; color: #1a1a1a; display: flex; align-items: center; justify-content: center; cursor: pointer; }
</style>

<script>
  const card = document.getElementById('install-card');
  const KEY = 'kurulum-karti';
  const store = {
    get: (k: string) => { try { return localStorage.getItem(k); } catch { return null; } },
    set: (k: string, v: string) => { try { localStorage.setItem(k, v); } catch {} },
  };

  const standalone = matchMedia('(display-mode: standalone)').matches || (navigator as Navigator & { standalone?: boolean }).standalone === true;
  const ua = navigator.userAgent;
  const isIOS = /iPhone|iPad|iPod/i.test(ua) && /Safari/i.test(ua) && !/CriOS|FxiOS|EdgiOS|GSA/i.test(ua);
  const snoozed = Date.now() - Number(store.get(KEY) ?? 0) < 30 * 86_400_000;
  const visits = Number(store.get('ziyaret-sayisi') ?? 0) + 1;
  store.set('ziyaret-sayisi', String(visits));
  // Daily-use pages, or anyone on their second visit.
  const eligiblePage = /^\/(toplu-tasima-saatleri|nobetci-eczaneler)/.test(location.pathname) || visits >= 2;

  let deferred: (Event & { prompt: () => Promise<void>; userChoice: Promise<{ outcome: string }> }) | null = null;

  function show(mode: 'android' | 'ios') {
    if (!card || standalone || snoozed || !eligiblePage) return;
    // Wait until the cookie banner is answered so the two never stack.
    if (store.get('cerez-tercihi') === null) return;
    // Once per browsing session is enough, even if it's not dismissed.
    try { if (sessionStorage.getItem(KEY)) return; sessionStorage.setItem(KEY, '1'); } catch {}
    card.querySelector<HTMLElement>('[data-ic-android]')!.hidden = mode !== 'android';
    card.querySelector<HTMLElement>('[data-ic-ios]')!.hidden = mode !== 'ios';
    card.querySelector<HTMLElement>('[data-ic-install]')!.hidden = mode !== 'android';
    setTimeout(() => { card.hidden = false; }, 6000);
  }
  function close() {
    if (card) card.hidden = true;
    store.set(KEY, String(Date.now()));
  }

  window.addEventListener('beforeinstallprompt', (e) => {
    e.preventDefault();
    deferred = e as typeof deferred;
    show('android');
  });
  if (isIOS) show('ios');

  card?.querySelector('[data-ic-install]')?.addEventListener('click', async () => {
    if (!deferred) return;
    await deferred.prompt();
    await deferred.userChoice.catch(() => null);
    deferred = null;
    close();
  });
  card?.querySelector('[data-ic-close]')?.addEventListener('click', close);
  window.addEventListener('appinstalled', close);

  if ('serviceWorker' in navigator && location.hostname !== 'localhost') {
    window.addEventListener('load', () => navigator.serviceWorker.register('/sw.js').catch(() => {}));
  }
</script>
