---
export const prerender = false;
import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="Sayfa Metinleri">
  <div style="max-width:800px">
    <div id="alert" class="alert"></div>
    <div id="loading" style="text-align:center;padding:60px;color:#6b7280;font-size:14px">Yükleniyor...</div>

    <form id="pages-form" style="display:none">
      <!-- Hero bölümü -->
      <div class="card" style="margin-bottom:24px">
        <h2 style="font-size:16px;font-weight:600;color:#111827;margin-bottom:4px">Ana Sayfa Hero</h2>
        <p style="font-size:13px;color:#6b7280;margin-bottom:20px">Sitenin giriş ekranındaki metinler</p>
        <div class="form-group">
          <label>Eyebrow Metin</label>
          <input type="text" id="hero-eyebrow" placeholder="İzmir Rehberi · 2026" />
        </div>
        <div class="form-group">
          <label>Büyük Başlık</label>
          <textarea id="hero-title" rows="3" placeholder="İzmir'i&#10;keşfetmenin&#10;en iyi yolu" style="font-family:-apple-system,sans-serif;font-size:14px"></textarea>
          <div style="font-size:12px;color:#9ca3af;margin-top:4px">Satır sonu için ↵ kullanın (mobilde tek satır olarak birleştirilir)</div>
        </div>
        <div class="form-group">
          <label>Alt Başlık</label>
          <textarea id="hero-subtitle" rows="2" placeholder="Yerel gözüyle kafeler, etkinlikler..."></textarea>
        </div>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px">
          <div class="form-group">
            <label>Ana Buton Metni</label>
            <input type="text" id="hero-ctaPrimary" placeholder="Rehberleri Keşfet" />
          </div>
          <div class="form-group">
            <label>İkinci Buton Metni</label>
            <input type="text" id="hero-ctaSecondary" placeholder="Bu Hafta Etkinlikler" />
          </div>
        </div>
      </div>

      <!-- Hakkında bölümü -->
      <div class="card" style="margin-bottom:24px">
        <h2 style="font-size:16px;font-weight:600;color:#111827;margin-bottom:4px">Hakkında Sayfası</h2>
        <p style="font-size:13px;color:#6b7280;margin-bottom:20px">Hakkında sayfasındaki metinler</p>
        <div class="form-group">
          <label>Sayfa Başlığı</label>
          <input type="text" id="about-heroTitle" placeholder="Hakkında" />
        </div>
        <div class="form-group">
          <label>Sayfa Alt Başlığı</label>
          <input type="text" id="about-heroDesc" placeholder="İzmir'i seven insanlar tarafından..." />
        </div>
        <div class="form-group">
          <label>Hikaye Başlığı</label>
          <textarea id="about-storyHeading" rows="2"></textarea>
        </div>
        <div class="form-group">
          <label>1. Paragraf</label>
          <textarea id="about-story0" rows="3"></textarea>
        </div>
        <div class="form-group">
          <label>2. Paragraf</label>
          <textarea id="about-story1" rows="3"></textarea>
        </div>
        <div class="form-group">
          <label>3. Paragraf</label>
          <textarea id="about-story2" rows="2"></textarea>
        </div>
      </div>

      <div style="display:flex;gap:12px">
        <button type="submit" class="btn btn-primary" id="save-btn">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>
          Değişiklikleri Kaydet
        </button>
        <p style="font-size:13px;color:#6b7280;align-self:center">Kayıt sonrası site yeniden oluşturulur (~1-2 dk)</p>
      </div>
    </form>
  </div>
</AdminLayout>

<style>
  .form-group { margin-bottom: 16px; }
  .form-group:last-child { margin-bottom: 0; }
  label { display: block; font-size: 13px; font-weight: 500; color: #374151; margin-bottom: 6px; }
  input[type="text"], textarea {
    width: 100%; padding: 9px 12px; border: 1.5px solid #d1d5db; border-radius: 8px;
    font-size: 14px; font-family: inherit; transition: border-color 0.15s; outline: none; color: #111827; background: #fff;
  }
  input:focus, textarea:focus { border-color: #062f96; box-shadow: 0 0 0 3px rgba(6,47,150,0.07); }
  textarea { resize: vertical; }
</style>

<script>
  let storedSha = '';

  async function loadConfig() {
    try {
      const res = await fetch('/api/admin/pages');
      if (res.status === 401) { window.location.href = '/admin/login'; return; }
      if (!res.ok) throw new Error(`${res.status}`);
      const data = await res.json();
      storedSha = data.sha || '';

      const set = (id: string, val: string) => {
        const el = document.getElementById(id) as HTMLInputElement;
        if (el) el.value = val || '';
      };

      set('hero-eyebrow', data.hero?.eyebrow);
      set('hero-title', data.hero?.title);
      set('hero-subtitle', data.hero?.subtitle);
      set('hero-ctaPrimary', data.hero?.ctaPrimary);
      set('hero-ctaSecondary', data.hero?.ctaSecondary);
      set('about-heroTitle', data.about?.heroTitle);
      set('about-heroDesc', data.about?.heroDesc);
      set('about-storyHeading', data.about?.storyHeading);
      const paragraphs = data.about?.storyParagraphs || [];
      set('about-story0', paragraphs[0]);
      set('about-story1', paragraphs[1]);
      set('about-story2', paragraphs[2]);

      (document.getElementById('loading') as HTMLElement).style.display = 'none';
      (document.getElementById('pages-form') as HTMLElement).style.display = '';
    } catch (err: any) {
      (document.getElementById('loading') as HTMLElement).textContent = 'Yüklenemedi: ' + err.message;
    }
  }

  document.getElementById('pages-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = document.getElementById('save-btn') as HTMLButtonElement;
    btn.disabled = true; btn.textContent = 'Kaydediliyor...';

    const get = (id: string) => (document.getElementById(id) as HTMLInputElement)?.value || '';
    const payload = {
      sha: storedSha,
      hero: {
        eyebrow: get('hero-eyebrow'),
        title: get('hero-title'),
        subtitle: get('hero-subtitle'),
        ctaPrimary: get('hero-ctaPrimary'),
        ctaSecondary: get('hero-ctaSecondary'),
      },
      about: {
        heroTitle: get('about-heroTitle'),
        heroDesc: get('about-heroDesc'),
        storyHeading: get('about-storyHeading'),
        storyParagraphs: [get('about-story0'), get('about-story1'), get('about-story2')].filter(Boolean),
      },
    };

    try {
      const res = await fetch('/api/admin/pages', {
        method: 'PUT', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload),
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || 'Kayıt başarısız');
      const alertEl = document.getElementById('alert')!;
      alertEl.textContent = 'Metinler kaydedildi. Site yeniden oluşturuluyor...';
      alertEl.className = 'alert alert-success show';
      window.scrollTo(0, 0);
      await loadConfig();
    } catch (err: any) {
      const alertEl = document.getElementById('alert')!;
      alertEl.textContent = err.message;
      alertEl.className = 'alert alert-error show';
    }
    btn.disabled = false; btn.textContent = 'Değişiklikleri Kaydet';
  });

  loadConfig();
</script>
