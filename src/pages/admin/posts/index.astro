---
export const prerender = false;
import AdminLayout from '../../../layouts/AdminLayout.astro';
---

<AdminLayout title="Blog Yazıları">
  <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:24px;flex-wrap:wrap;gap:12px">
    <div id="post-count" style="font-size:14px;color:#6b7280"></div>
    <a href="/admin/posts/new" class="btn btn-primary">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
      Yeni Yazı
    </a>
  </div>

  <div id="alert" class="alert"></div>

  <div class="card" style="padding:0;overflow:hidden">
    <div id="loading" style="padding:40px;text-align:center;color:#6b7280;font-size:14px">Yazılar yükleniyor...</div>
    <div id="empty" style="padding:40px;text-align:center;color:#6b7280;font-size:14px;display:none">
      Henüz hiç yazı yok. <a href="/admin/posts/new" style="color:#062f96">İlk yazıyı ekle →</a>
    </div>
    <table id="posts-table" style="width:100%;border-collapse:collapse;display:none">
      <thead>
        <tr style="border-bottom:1px solid #e5e7eb;background:#f9fafb">
          <th style="text-align:left;padding:12px 20px;font-size:12px;font-weight:600;text-transform:uppercase;letter-spacing:0.05em;color:#6b7280">Başlık</th>
          <th style="text-align:left;padding:12px 16px;font-size:12px;font-weight:600;text-transform:uppercase;letter-spacing:0.05em;color:#6b7280;white-space:nowrap">Kategori</th>
          <th style="text-align:left;padding:12px 16px;font-size:12px;font-weight:600;text-transform:uppercase;letter-spacing:0.05em;color:#6b7280;white-space:nowrap">Tarih</th>
          <th style="padding:12px 20px;font-size:12px;font-weight:600;text-transform:uppercase;letter-spacing:0.05em;color:#6b7280;text-align:right">İşlem</th>
        </tr>
      </thead>
      <tbody id="posts-body"></tbody>
    </table>
  </div>
</AdminLayout>

<script>
  const catColors: Record<string,string> = {
    'Kafeler': '#1d4ed8', 'Semtler': '#7c3aed', 'Gece Hayatı': '#db2777',
    'Keşfet': '#059669', 'Etkinlikler': '#d97706',
  };
  const catBg: Record<string,string> = {
    'Kafeler': '#dbeafe', 'Semtler': '#ede9fe', 'Gece Hayatı': '#fce7f3',
    'Keşfet': '#d1fae5', 'Etkinlikler': '#fef3c7',
  };

  async function loadPosts() {
    try {
      const res = await fetch('/api/admin/posts');
      if (!res.ok) {
        if (res.status === 401) { window.location.href = '/admin/login'; return; }
        throw new Error(`${res.status}`);
      }
      const { posts } = await res.json();
      const countEl = document.getElementById('post-count')!;
      const loading = document.getElementById('loading')!;
      const empty = document.getElementById('empty')!;
      const table = document.getElementById('posts-table')!;
      const tbody = document.getElementById('posts-body')!;

      loading.style.display = 'none';
      countEl.textContent = `${posts.length} yazı`;

      if (!posts.length) { empty.style.display = 'block'; return; }

      table.style.display = '';
      tbody.innerHTML = posts.map((p: any) => {
        const date = p.pubDate ? new Date(p.pubDate).toLocaleDateString('tr-TR', { day:'numeric', month:'short', year:'numeric' }) : '-';
        const cc = catColors[p.category] || '#6b7280';
        const bc = catBg[p.category] || '#f3f4f6';
        return `
          <tr style="border-bottom:1px solid #e5e7eb" class="post-row">
            <td style="padding:14px 20px">
              <div style="font-size:14px;font-weight:500;color:#111827;margin-bottom:2px">${esc(p.title)}</div>
              <div style="font-size:12px;color:#9ca3af">${esc(p.slug)}</div>
            </td>
            <td style="padding:14px 16px;white-space:nowrap">
              ${p.category ? `<span style="display:inline-block;font-size:11px;font-weight:600;padding:2px 10px;border-radius:20px;background:${bc};color:${cc}">${esc(p.category)}</span>` : '-'}
              ${p.featured ? '<span style="display:inline-block;font-size:10px;font-weight:600;padding:2px 8px;border-radius:20px;background:#fef9c3;color:#a16207;margin-left:4px">★ Öne Çıkan</span>' : ''}
            </td>
            <td style="padding:14px 16px;font-size:13px;color:#6b7280;white-space:nowrap">${date}</td>
            <td style="padding:14px 20px;text-align:right;white-space:nowrap">
              <a href="/admin/posts/${esc(p.slug)}" style="display:inline-flex;align-items:center;gap:4px;font-size:13px;font-weight:500;color:#062f96;margin-right:12px">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                Düzenle
              </a>
              <button onclick="deletePost('${esc(p.slug)}', '${esc(p.title)}')" style="display:inline-flex;align-items:center;gap:4px;font-size:13px;font-weight:500;color:#dc2626;background:none;border:none;cursor:pointer;padding:0">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/><path d="M10 11v6"/><path d="M14 11v6"/></svg>
                Sil
              </button>
            </td>
          </tr>`;
      }).join('');
    } catch (err: any) {
      document.getElementById('loading')!.textContent = 'Yazılar yüklenemedi: ' + err.message;
    }
  }

  function esc(s: string) {
    return String(s || '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
  }

  async function deletePost(slug: string, title: string) {
    if (!confirm(`"${title}" yazısını silmek istediğinizden emin misiniz?`)) return;
    try {
      const res = await fetch(`/api/admin/post/${slug}`, { method: 'DELETE' });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || 'Silme başarısız');
      showAlert('Yazı başarıyla silindi.', 'success');
      loadPosts();
    } catch (err: any) {
      showAlert(err.message, 'error');
    }
  }

  function showAlert(msg: string, type: 'success'|'error') {
    const el = document.getElementById('alert')!;
    el.textContent = msg;
    el.className = `alert ${type === 'error' ? 'alert-error' : 'alert-success'} show`;
    setTimeout(() => el.classList.remove('show'), 5000);
  }

  loadPosts();
</script>
