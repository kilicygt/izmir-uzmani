---
export const prerender = false;
import AdminLayout from '../../../layouts/AdminLayout.astro';

const categories = ['Kafeler', 'Semtler', 'Gece Hayatı', 'Keşfet', 'Etkinlikler'];
const { slug } = Astro.params;
---

<AdminLayout title="Yazıyı Düzenle">
  <div style="max-width:900px">
    <a href="/admin/posts" style="display:inline-flex;align-items:center;gap:6px;font-size:13px;color:#6b7280;margin-bottom:20px;text-decoration:none" onmouseover="this.style.color='#111827'" onmouseout="this.style.color='#6b7280'">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
      Yazılara Dön
    </a>

    <div id="alert" class="alert"></div>

    <div id="loading" style="text-align:center;padding:60px;color:#6b7280;font-size:14px">Yazı yükleniyor...</div>

    <form id="post-form" style="display:none">
      <div style="display:grid;grid-template-columns:1fr 320px;gap:24px;align-items:start">
        <div style="display:flex;flex-direction:column;gap:20px">
          <div class="card">
            <h2 style="font-size:14px;font-weight:600;color:#374151;margin-bottom:16px;padding-bottom:12px;border-bottom:1px solid #f3f4f6">Temel Bilgiler</h2>
            <div class="form-group">
              <label>Başlık <span class="req">*</span></label>
              <input type="text" id="title" name="title" required placeholder="Yazı başlığını girin" />
            </div>
            <div class="form-group">
              <label>Slug (URL) <span style="font-size:11px;color:#9ca3af">(değiştirmeyin — URL bozulur)</span></label>
              <input type="text" id="slug-display" readonly style="background:#f9fafb;color:#6b7280;cursor:default" />
              <div style="font-size:12px;color:#9ca3af;margin-top:4px">izmiruzmani.com/rehberler/<span id="slug-preview" style="color:#062f96"></span></div>
            </div>
            <div class="form-group">
              <label>Açıklama <span class="req">*</span></label>
              <textarea id="description" name="description" rows="2" required placeholder="Yazı açıklaması"></textarea>
            </div>
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px">
              <div class="form-group">
                <label>Kategori <span class="req">*</span></label>
                <select id="category" name="category" required>
                  <option value="">Seçin...</option>
                  {categories.map(c => <option value={c}>{c}</option>)}
                </select>
              </div>
              <div class="form-group">
                <label>Yayın Tarihi <span class="req">*</span></label>
                <input type="date" id="pubDate" name="pubDate" required />
              </div>
            </div>
          </div>

          <div class="card">
            <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px;padding-bottom:12px;border-bottom:1px solid #f3f4f6">
              <h2 style="font-size:14px;font-weight:600;color:#374151">İçerik (Markdown)</h2>
              <div style="display:flex;gap:4px">
                <button type="button" onclick="mdCmd('bold')" class="md-btn"><strong>B</strong></button>
                <button type="button" onclick="mdCmd('italic')" class="md-btn"><em>İ</em></button>
                <button type="button" onclick="mdCmd('h2')" class="md-btn">H2</button>
                <button type="button" onclick="mdCmd('h3')" class="md-btn">H3</button>
                <button type="button" onclick="mdCmd('quote')" class="md-btn">"</button>
                <button type="button" onclick="mdCmd('link')" class="md-btn">🔗</button>
                <button type="button" onclick="mdCmd('ul')" class="md-btn">≡</button>
              </div>
            </div>
            <textarea id="content" name="content" rows="18" style="width:100%;font-family:'SF Mono',monospace;font-size:13px;line-height:1.7;resize:vertical"></textarea>
          </div>

          <div class="card">
            <h2 style="font-size:14px;font-weight:600;color:#374151;margin-bottom:16px;padding-bottom:12px;border-bottom:1px solid #f3f4f6">SEO & Meta</h2>
            <div class="form-group">
              <label>SEO Başlığı <span style="font-size:11px;color:#9ca3af">(max 60 karakter)</span></label>
              <input type="text" id="seoTitle" name="seoTitle" maxlength="60" oninput="updateCount(this,'seo-title-count',60)" />
              <div style="font-size:11px;color:#9ca3af;margin-top:4px;text-align:right"><span id="seo-title-count">0</span>/60</div>
            </div>
            <div class="form-group">
              <label>SEO Açıklaması <span style="font-size:11px;color:#9ca3af">(max 160 karakter)</span></label>
              <textarea id="seoDescription" name="seoDescription" rows="2" maxlength="160" oninput="updateCount(this,'seo-desc-count',160)"></textarea>
              <div style="font-size:11px;color:#9ca3af;margin-top:4px;text-align:right"><span id="seo-desc-count">0</span>/160</div>
            </div>
            <div class="form-group">
              <label>Kısa Açıklama (Excerpt)</label>
              <textarea id="excerpt" name="excerpt" rows="2" placeholder="Kartlarda görünecek kısa özet"></textarea>
            </div>
          </div>
        </div>

        <div style="display:flex;flex-direction:column;gap:16px;position:sticky;top:20px">
          <div class="card">
            <h2 style="font-size:14px;font-weight:600;color:#374151;margin-bottom:16px">Kaydet</h2>
            <button type="submit" class="btn btn-primary" style="width:100%;justify-content:center" id="save-btn">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>
              Güncelle
            </button>
          </div>

          <div class="card">
            <h2 style="font-size:14px;font-weight:600;color:#374151;margin-bottom:16px">Kapak Görseli</h2>
            <div id="image-preview" style="background:#f3f4f6;border-radius:8px;aspect-ratio:16/9;display:flex;align-items:center;justify-content:center;margin-bottom:12px;overflow:hidden">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#9ca3af" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/><circle cx="12" cy="13" r="4"/></svg>
            </div>
            <input type="file" id="image-file" accept="image/*" style="display:none" />
            <button type="button" onclick="document.getElementById('image-file').click()" class="btn btn-ghost btn-sm" style="width:100%;justify-content:center;margin-bottom:8px">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
              Görsel Yükle
            </button>
            <input type="text" id="image" name="image" placeholder="/images/uploads/gorsel.jpg" style="font-size:12px" />
            <div id="upload-status" style="font-size:12px;color:#6b7280;margin-top:6px;min-height:16px"></div>
          </div>

          <div class="card">
            <h2 style="font-size:14px;font-weight:600;color:#374151;margin-bottom:16px">Ayarlar</h2>
            <div class="form-group">
              <label>Etiketler <span style="font-size:11px;color:#9ca3af">(virgülle ayır)</span></label>
              <input type="text" id="tags" name="tags" />
            </div>
            <div class="form-group">
              <label>Okuma Süresi</label>
              <input type="text" id="readTime" name="readTime" placeholder="5 dk" />
            </div>
            <div style="display:flex;align-items:center;gap:10px;margin-top:4px">
              <input type="checkbox" id="featured" name="featured" style="width:16px;height:16px;cursor:pointer" />
              <label for="featured" style="font-size:14px;cursor:pointer;font-weight:400;margin-bottom:0">Öne Çıkan Yazı</label>
            </div>
          </div>

          <div class="card" style="border-color:#fee2e2">
            <h2 style="font-size:14px;font-weight:600;color:#dc2626;margin-bottom:12px">Tehlikeli Alan</h2>
            <button type="button" id="delete-btn" class="btn btn-danger" style="width:100%;justify-content:center">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/></svg>
              Bu Yazıyı Sil
            </button>
          </div>
        </div>
      </div>
    </form>
  </div>
</AdminLayout>

<style>
  .form-group { margin-bottom: 16px; }
  .form-group:last-child { margin-bottom: 0; }
  label { display: block; font-size: 13px; font-weight: 500; color: #374151; margin-bottom: 6px; }
  .req { color: #dc2626; }
  input[type="text"], input[type="date"], select, textarea {
    width: 100%; padding: 9px 12px; border: 1.5px solid #d1d5db; border-radius: 8px;
    font-size: 14px; font-family: inherit; transition: border-color 0.15s; outline: none; color: #111827; background: #fff;
  }
  input:focus, select:focus, textarea:focus { border-color: #062f96; box-shadow: 0 0 0 3px rgba(6,47,150,0.07); }
  textarea { resize: vertical; }
  .md-btn { padding: 4px 8px; background: #f3f4f6; border: 1px solid #e5e7eb; border-radius: 5px; font-size: 12px; cursor: pointer; transition: background 0.1s; }
  .md-btn:hover { background: #e5e7eb; }
</style>

<script define:vars={{ slug }}>
  const POST_SLUG = slug;

  (window as any).updateCount = function(el: HTMLInputElement, countId: string, max: number) {
    const n = el.value.length;
    const countEl = document.getElementById(countId)!;
    countEl.textContent = String(n);
    countEl.style.color = n > max * 0.9 ? '#dc2626' : '#9ca3af';
  };

  (window as any).mdCmd = function(cmd: string) {
    const ta = document.getElementById('content') as HTMLTextAreaElement;
    const s = ta.selectionStart, e = ta.selectionEnd;
    const sel = ta.value.slice(s, e);
    let ins = '';
    if (cmd === 'bold') ins = `**${sel || 'kalın metin'}**`;
    else if (cmd === 'italic') ins = `*${sel || 'italik metin'}*`;
    else if (cmd === 'h2') ins = `\n## ${sel || 'Başlık'}\n`;
    else if (cmd === 'h3') ins = `\n### ${sel || 'Alt Başlık'}\n`;
    else if (cmd === 'quote') ins = `\n> ${sel || 'Alıntı'}\n`;
    else if (cmd === 'link') ins = `[${sel || 'bağlantı metni'}](https://)`;
    else if (cmd === 'ul') ins = `\n- ${sel || 'liste öğesi'}\n`;
    ta.value = ta.value.slice(0, s) + ins + ta.value.slice(e);
    ta.focus(); ta.selectionStart = ta.selectionEnd = s + ins.length;
  };

  // Load post
  async function loadPost() {
    try {
      const res = await fetch(`/api/admin/post/${POST_SLUG}`);
      if (res.status === 401) { window.location.href = '/admin/login'; return; }
      if (!res.ok) throw new Error(`${res.status}`);
      const { data, content } = await res.json();

      (document.getElementById('loading') as HTMLElement).style.display = 'none';
      (document.getElementById('post-form') as HTMLElement).style.display = '';

      const set = (id: string, val: any) => {
        const el = document.getElementById(id) as HTMLInputElement;
        if (el) el.value = val || '';
      };

      set('title', data.title);
      (document.getElementById('slug-display') as HTMLInputElement).value = POST_SLUG;
      (document.getElementById('slug-preview') as HTMLElement).textContent = POST_SLUG;
      set('description', data.description);
      set('pubDate', data.pubDate ? data.pubDate.slice(0, 10) : '');
      set('content', content);
      set('image', data.image);
      set('excerpt', data.excerpt);
      set('seoTitle', data.seoTitle);
      set('seoDescription', data.seoDescription);
      set('tags', Array.isArray(data.tags) ? data.tags.join(', ') : (data.tags || ''));
      set('readTime', data.readTime);
      if (data.featured) (document.getElementById('featured') as HTMLInputElement).checked = true;

      const catEl = document.getElementById('category') as HTMLSelectElement;
      if (data.category) catEl.value = data.category;

      if (data.image) {
        (document.getElementById('image-preview') as HTMLElement).innerHTML =
          `<img src="${data.image}" style="width:100%;height:100%;object-fit:cover" alt="Kapak" />`;
      }

      // Update counters
      const sTitleEl = document.getElementById('seoTitle') as HTMLInputElement;
      const sDescEl = document.getElementById('seoDescription') as HTMLTextAreaElement;
      if (sTitleEl.value) (window as any).updateCount(sTitleEl, 'seo-title-count', 60);
      if (sDescEl.value) (window as any).updateCount(sDescEl, 'seo-desc-count', 160);
    } catch (err: any) {
      (document.getElementById('loading') as HTMLElement).textContent = 'Yüklenemedi: ' + err.message;
    }
  }

  // Image upload
  document.getElementById('image-file')?.addEventListener('change', async function(this: HTMLInputElement) {
    const file = this.files?.[0]; if (!file) return;
    const statusEl = document.getElementById('upload-status')!;
    statusEl.textContent = 'Yükleniyor...';
    try {
      const fd = new FormData(); fd.append('file', file);
      const res = await fetch('/api/admin/upload', { method: 'POST', body: fd });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error);
      (document.getElementById('image') as HTMLInputElement).value = data.path;
      (document.getElementById('image-preview') as HTMLElement).innerHTML =
        `<img src="${data.path}" style="width:100%;height:100%;object-fit:cover" alt="Kapak" />`;
      statusEl.textContent = '✓ ' + data.path; statusEl.style.color = '#059669';
    } catch (err: any) {
      statusEl.textContent = '✗ ' + err.message; statusEl.style.color = '#dc2626';
    }
    this.value = '';
  });

  document.getElementById('image')?.addEventListener('input', function(this: HTMLInputElement) {
    if (this.value) {
      (document.getElementById('image-preview') as HTMLElement).innerHTML =
        `<img src="${this.value}" style="width:100%;height:100%;object-fit:cover" alt="Kapak" />`;
    }
  });

  // Form submit
  document.getElementById('post-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = document.getElementById('save-btn') as HTMLButtonElement;
    btn.disabled = true; btn.textContent = 'Kaydediliyor...';
    const get = (id: string) => (document.getElementById(id) as HTMLInputElement)?.value || '';
    const body = {
      title: get('title'), description: get('description'), category: get('category'),
      pubDate: get('pubDate'), content: get('content'), image: get('image'),
      excerpt: get('excerpt'), seoTitle: get('seoTitle'), seoDescription: get('seoDescription'),
      tags: get('tags'), readTime: get('readTime'),
      featured: (document.getElementById('featured') as HTMLInputElement)?.checked || false,
    };
    try {
      const res = await fetch(`/api/admin/post/${POST_SLUG}`, {
        method: 'PUT', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body),
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || 'Güncelleme başarısız');
      const alertEl = document.getElementById('alert')!;
      alertEl.textContent = 'Yazı başarıyla güncellendi. Site yeniden oluşturuluyor...';
      alertEl.className = 'alert alert-success show';
      window.scrollTo(0, 0);
      btn.disabled = false; btn.textContent = 'Güncelle';
    } catch (err: any) {
      const alertEl = document.getElementById('alert')!;
      alertEl.textContent = err.message;
      alertEl.className = 'alert alert-error show';
      btn.disabled = false; btn.textContent = 'Güncelle';
      window.scrollTo(0, 0);
    }
  });

  // Delete
  document.getElementById('delete-btn')?.addEventListener('click', async () => {
    if (!confirm('Bu yazıyı silmek istediğinizden emin misiniz? Bu işlem geri alınamaz.')) return;
    try {
      const res = await fetch(`/api/admin/post/${POST_SLUG}`, { method: 'DELETE' });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || 'Silme başarısız');
      window.location.href = '/admin/posts';
    } catch (err: any) {
      const alertEl = document.getElementById('alert')!;
      alertEl.textContent = err.message;
      alertEl.className = 'alert alert-error show';
    }
  });

  loadPost();
</script>
