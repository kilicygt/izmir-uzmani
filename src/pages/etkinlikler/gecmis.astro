---
import Layout from '../../layouts/Layout.astro';
import { getPastEvents, fmt, dayMonth, weekday, time, catColor, type EventItem } from '../../lib/events';

const events = await getPastEvents();

const monthOf = (e: EventItem) => fmt(e.next.end, { month: 'long', year: 'numeric' });
const months = new Map<string, EventItem[]>();
for (const e of events) months.set(monthOf(e), [...(months.get(monthOf(e)) ?? []), e]);

const dayKey = (d: string) => fmt(d, { year: 'numeric', month: '2-digit', day: '2-digit' });
const isRange = (e: EventItem) => dayKey(e.sessions[0].start) !== dayKey(e.sessions[e.sessions.length - 1].end);
---

<Layout title="Geçmiş Etkinlikler" activePage="etkinlikler" description="İzmir'de daha önce düzenlenen konser, tiyatro, sergi ve sinema etkinliklerinin arşivi.">

  <section class="page-header">
    <div class="container anim">
      <p class="breadcrumb"><a href="/" class="bc-link">Ana Sayfa</a> · <a href="/etkinlikler" class="bc-link">Etkinlikler</a> · Geçmiş Etkinlikler</p>
      <h1 class="page-title">Geçmiş Etkinlikler</h1>
      <p class="page-desc">İzmir'de daha önce düzenlenen konser, tiyatro, sergi ve sinema etkinlikleri.</p>
      <a href="/etkinlikler" class="upcoming-link">Yaklaşan etkinlikleri gör →</a>
    </div>
  </section>

  <section class="events-section">
    <div class="container">
      {events.length === 0 && <p class="empty-note">Henüz arşivde etkinlik yok.</p>}
      <div class="event-groups">
        {[...months].map(([month, list]) => (
          <div class="event-group">
            <h2 class="group-header">{month}</h2>
            <div class="events-list">
              {list.map(ev => (
                <a href={`/etkinlikler/${ev.slug}`} class="event-row">
                  <div class="thumb">{ev.image && <img src={ev.image} alt="" loading="lazy" decoding="async" />}</div>
                  <div class="event-date">
                    {isRange(ev) ? (
                      <>
                        <p class="ev-date">{dayMonth(ev.sessions[0].start)} – {dayMonth(ev.next.end)}</p>
                        <p class="ev-time">{fmt(ev.next.end, { year: 'numeric' })}</p>
                      </>
                    ) : (
                      <>
                        <p class="ev-date">{weekday(ev.next.start)} {dayMonth(ev.next.start)}</p>
                        <p class="ev-time">{time(ev.next.start)}</p>
                      </>
                    )}
                  </div>
                  <div class="event-divider"></div>
                  <div class="event-info">
                    <p class="ev-title">{ev.title}</p>
                    {ev.next.venue && <p class="ev-venue">{ev.next.venue}</p>}
                  </div>
                  <span class="cat-badge" style={`background:${catColor(ev.category)}`}>{ev.category.trim()}</span>
                </a>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

</Layout>

<style>
  .container { max-width: 1200px; margin: 0 auto; padding: 0 20px; }
  .anim { animation: fadeUp 0.5s ease both; }

  .page-header { background: linear-gradient(180deg, #fff9f3 0%, #f5e8d8 100%); padding: clamp(32px, 5vw, 56px) 20px; }
  .breadcrumb { font-size: 12px; color: #999; margin-bottom: 16px; }
  .bc-link { color: #062f96; transition: opacity 0.15s; }
  .bc-link:hover { opacity: 0.7; color: #062f96; }
  .page-title { font-family: 'Fraunces', serif; font-size: clamp(32px, 5vw, 52px); font-weight: 800; letter-spacing: -0.02em; line-height: 1.08; color: #1a1a1a; margin-bottom: 12px; }
  .page-desc { font-size: 16px; color: #555; max-width: 560px; line-height: 1.7; }
  .upcoming-link { display: inline-block; margin-top: 18px; font-size: 14px; font-weight: 600; color: #fff; background: #062f96; padding: 11px 20px; border-radius: 999px; }
  .upcoming-link:hover { background: #041e6e; color: #fff; }

  .events-section { background: #fff9f3; padding: clamp(40px,5vw,64px) 20px; }
  .event-groups { display: flex; flex-direction: column; gap: 40px; }
  .group-header {
    font-family: 'Fraunces', serif; font-size: clamp(20px, 2.4vw, 26px); font-weight: 700;
    color: #1a1a1a; margin-bottom: 16px; text-transform: capitalize;
  }
  .events-list {
    background: #fff; border-radius: 20px; overflow: hidden;
    border: 1px solid rgba(0,0,0,0.06);
  }
  .event-row {
    display: flex; align-items: center; gap: 16px;
    padding: 14px 20px; border-bottom: 1px solid rgba(0,0,0,0.05);
    transition: background 0.15s; color: inherit; flex-wrap: wrap;
  }
  .event-row:last-child { border-bottom: none; }
  .event-row:hover { background: #faf7f4; }
  .thumb { width: 52px; height: 64px; border-radius: 10px; overflow: hidden; background: #efe4d8; flex-shrink: 0; }
  .thumb img { width: 100%; height: 100%; object-fit: cover; object-position: top; filter: saturate(0.6); display: block; }
  .event-date { flex-shrink: 0; min-width: 96px; }
  .ev-date { font-size: 15px; font-weight: 600; color: #1a1a1a; line-height: 1.2; }
  .ev-time { font-size: 12px; color: #999; margin-top: 1px; }
  @media (max-width: 600px) { .event-divider { display: none; } .cat-badge { display: none; } }
  .event-divider { width: 1px; height: 36px; background: rgba(0,0,0,0.08); flex-shrink: 0; }
  .event-info { flex: 1; min-width: 160px; }
  .ev-title { font-size: 15px; font-weight: 500; color: #1a1a1a; margin-bottom: 2px; }
  .ev-venue { font-size: 12px; color: #999; }
  .cat-badge {
    display: inline-block; font-size: 11px; font-weight: 600; white-space: nowrap;
    padding: 4px 12px; border-radius: 20px; letter-spacing: 0.03em; color: #fff;
  }
  .empty-note { font-size: 15px; color: #666; text-align: center; padding: 32px 0; }
</style>
