---
import Layout from '../../layouts/Layout.astro';
import { getEvents, groupEvents, dayMonth, weekday, time, catColor } from '../../lib/events';

const groups = groupEvents(await getEvents());
---

<Layout title="Etkinlikler" activePage="etkinlikler" description="İzmir'deki güncel konser, tiyatro, sergi, sinema ve kültür etkinlikleri.">

  <!-- PAGE HEADER -->
  <section class="page-header">
    <div class="container anim">
      <p class="breadcrumb"><a href="/" class="bc-link">Ana Sayfa</a> · Etkinlikler</p>
      <h1 class="page-title">Etkinlikler</h1>
      <p class="page-desc">İzmir'deki konser, tiyatro, sergi, sinema ve kültür etkinlikleri.</p>
    </div>
  </section>

  <!-- FILTER -->
  <div class="filter-bar">
    <div class="container">
      {['Bu Hafta', 'Bu Ay', 'Tümü'].map((f, i) => (
        <button class:list={['filter-btn', { active: i === 0 }]} data-filter={f}>{f}</button>
      ))}
      <a href="/etkinlikler/gecmis" class="past-link">Geçmiş Etkinlikler →</a>
    </div>
  </div>

  <!-- EVENT GROUPS -->
  <section class="events-section">
    <div class="container">
      <div class="event-groups" id="event-groups">
        {groups.map(group => (
          <div class="event-group" data-filters={group.filters.join('|')}>
            <p class="group-header">{group.header}</p>
            <div class="events-list">
              {group.events.map(ev => (
                <a href={`/etkinlikler/${ev.slug}`} class="event-row" data-end={ev.sessions[ev.sessions.length - 1].end}>
                  <div class="event-date">
                    {ev.ongoing ? (
                      <>
                        <p class="ev-date">{dayMonth(ev.next.end)}</p>
                        <p class="ev-time">tarihine kadar</p>
                      </>
                    ) : (
                      <>
                        <p class="ev-date">{weekday(ev.next.start)} {dayMonth(ev.next.start)}</p>
                        <p class="ev-time">{time(ev.next.start)}{ev.sessions.length > 1 && ` · ${ev.sessions.length} seans`}</p>
                      </>
                    )}
                  </div>
                  <div class="event-divider"></div>
                  <div class="event-info">
                    <p class="ev-title">{ev.title}</p>
                    {ev.next.venue && <p class="ev-venue">{ev.next.venue}</p>}
                  </div>
                  <span class="cat-badge" style={`background:${catColor(ev.category)};font-size:11px;white-space:nowrap`}>{ev.category}</span>
                </a>
              ))}
            </div>
          </div>
        ))}
      </div>
      <p class="empty-note" id="empty-note" hidden={groups.length > 0}>Şu an listelenecek etkinlik yok. Kısa süre içinde yeni etkinlikler eklenecek.</p>
      <p class="source-note">
        Etkinlik bilgileri <a href="https://kultursanat.izmir.bel.tr/" target="_blank" rel="noopener">İzmir Büyükşehir Belediyesi Kültürsanat</a> sayfasından her gün güncellenir. Tarih, saat ve bilet bilgisi değişebilir; güncel bilgi için etkinliğin resmi sayfasını kontrol edin.
      </p>
    </div>
  </section>

</Layout>

<style>
  .container { max-width: 1200px; margin: 0 auto; padding: 0 20px; }
  .anim { animation: fadeUp 0.5s ease both; }

  .page-header { background: #f0e8df; padding: 48px 20px; }
  .breadcrumb { font-size: 12px; color: #999; margin-bottom: 10px; }
  .bc-link { color: #062f96; transition: opacity 0.15s; }
  .bc-link:hover { opacity: 0.7; color: #062f96; }
  .page-title { font-size: clamp(28px,4vw,40px); font-weight: 600; color: #1a1a1a; margin-bottom: 8px; }
  .page-desc { font-size: 15px; color: #666; }

  .filter-bar {
    background: #fff9f3; padding: 16px 20px;
    border-bottom: 1px solid #ede5db;
    display: flex;
  }
  .filter-bar .container { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; }
  .past-link { margin-left: auto; font-size: 13px; font-weight: 500; color: #062f96; padding: 8px 4px; }
  .past-link:hover { opacity: 0.75; color: #062f96; }
  .filter-btn {
    font-family: 'Poppins', sans-serif; font-size: 13px; font-weight: 500;
    padding: 8px 20px; border-radius: 20px; cursor: pointer;
    background: #fff; color: #555; border: 1.5px solid #e0d8d0;
    transition: background 0.2s, color 0.2s;
  }
  .filter-btn.active { background: #1a1a1a; color: #fff; border-color: #1a1a1a; }
  .filter-btn:hover:not(.active) { border-color: #999; }

  .events-section { background: #fff9f3; padding: clamp(40px,5vw,64px) 20px; }
  .event-groups { display: flex; flex-direction: column; gap: 40px; }

  .event-group[hidden], .event-row[hidden] { display: none; }

  .group-header {
    font-size: 12px; font-weight: 600; letter-spacing: 0.08em;
    text-transform: uppercase; color: #999; margin-bottom: 16px;
  }
  .events-list {
    background: #fff; border-radius: 14px; overflow: hidden;
    border: 1px solid rgba(0,0,0,0.06);
  }
  .event-row {
    display: flex; align-items: center; gap: 16px;
    padding: 18px 24px; border-bottom: 1px solid rgba(0,0,0,0.05);
    transition: background 0.15s; color: inherit; flex-wrap: wrap;
  }
  .event-row:last-child { border-bottom: none; }
  .event-row:hover { background: #faf7f4; }
  .event-date { flex-shrink: 0; min-width: 96px; }
  .ev-date { font-size: 15px; font-weight: 600; color: #1a1a1a; line-height: 1.2; }
  .ev-time { font-size: 12px; color: #999; margin-top: 1px; }
  .event-divider { width: 1px; height: 36px; background: rgba(0,0,0,0.08); flex-shrink: 0; }
  .event-info { flex: 1; min-width: 160px; }
  .ev-title { font-size: 15px; font-weight: 500; color: #1a1a1a; margin-bottom: 2px; }
  .ev-venue { font-size: 12px; color: #999; }
  .cat-badge {
    display: inline-block; font-size: 11px; font-weight: 600;
    padding: 4px 12px; border-radius: 20px; letter-spacing: 0.03em; color: #fff;
  }
  .empty-note { font-size: 15px; color: #666; text-align: center; padding: 32px 0; }
  .source-note { font-size: 12px; color: #999; margin-top: 32px; line-height: 1.6; max-width: 720px; }
  .source-note a { color: #062f96; text-decoration: underline; }
</style>

<script>
  const filterBtns = document.querySelectorAll('.filter-btn');
  const groups = document.querySelectorAll<HTMLElement>('.event-group');

  // The page is rebuilt daily; hide anything that ended since the last build.
  const now = Date.now();
  document.querySelectorAll<HTMLElement>('.event-row').forEach(row => {
    if (new Date(row.dataset.end ?? '').getTime() < now) row.hidden = true;
  });

  function apply(filter: string) {
    let visible = 0;
    groups.forEach(g => {
      const show = (g.dataset.filters ?? '').split('|').includes(filter) && !!g.querySelector('.event-row:not([hidden])');
      g.hidden = !show;
      if (show) visible++;
    });
    const empty = document.getElementById('empty-note');
    if (empty) empty.hidden = visible > 0;
  }

  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      filterBtns.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      apply(btn.getAttribute('data-filter') ?? 'Tümü');
    });
  });
  apply('Bu Hafta');
</script>
