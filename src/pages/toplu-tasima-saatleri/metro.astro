---
import Layout from '../../layouts/Layout.astro';
import UlasimHeader from '../../components/UlasimHeader.astro';
import '../../styles/ulasim.css';
import { BASE, TARIFFS, metro, every, updatedAt } from '../../lib/ulasim';

const freq = metro.frequencies as Record<string, { from: string; to: string; every: number }[]>;
const first = metro.stations[0];
const last = metro.stations[metro.stations.length - 1];
---

<Layout title="İzmir Metro Sefer Saatleri ve Sıklıkları" activePage="ulasim" description={`İzmir Metro ${first} – ${last} hattının hafta içi, cumartesi ve pazar sefer sıklıkları, ilk ve son sefer saatleri ve istasyon listesi.`}>
  <UlasimHeader
    title="Metro Sefer Saatleri"
    desc={`İzmir Metro ${first} – ${last} hattında saat dilimlerine göre sefer sıklığı.`}
    crumbs={[{ href: `${BASE}/`, label: 'Toplu Taşıma Saatleri' }]}
    chips={[`${metro.stations.length} istasyon`, ...(updatedAt('metro') ? [`Güncelleme: ${updatedAt('metro')}`] : [])]}
  />

  <section class="tt-main">
    <div class="tt-container">
      <div class="tt-tabs" data-tabs="metro">
        {TARIFFS.map((t) => <button class="tt-tab" data-tab={t.id} data-days={t.days}>{t.label}</button>)}
      </div>
      {TARIFFS.map((t) => (
        <div class="tt-panel" data-panel={t.id} data-panel-of="metro" hidden={t.id !== '1'}>
          <div class="tt-card">
            {freq[t.id]?.length ? (
              <table class="tt-table">
                <tbody>
                  {freq[t.id].map((f) => <tr><td>{f.from} – {f.to}</td><td>{every(f.every)}</td></tr>)}
                </tbody>
              </table>
            ) : <p class="tt-empty">Bu gün için bilgi yok.</p>}
          </div>
        </div>
      ))}

      <div class="tt-section" style="margin-top:40px">
        <p class="tt-label">İstasyonlar</p>
        <div class="tt-card">
          <p class="tt-text">{metro.stations.join(' → ')}</p>
        </div>
      </div>

      <p class="tt-note">
        Tablodaki süreler iki tren arasındaki ortalama bekleme süresidir. Kaynak: İzmir Metro A.Ş., İzmir Büyükşehir Belediyesi açık veri portalı. Güncel duyurular için <a href="https://www.izmirmetro.com.tr/" target="_blank" rel="noopener">izmirmetro.com.tr</a> adresini kontrol edin.
      </p>
    </div>
  </section>
</Layout>

<script>
  import '../../scripts/ulasim';
</script>
