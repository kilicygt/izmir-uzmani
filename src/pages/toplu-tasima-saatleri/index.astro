---
import Layout from '../../layouts/Layout.astro';
import UlasimHeader from '../../components/UlasimHeader.astro';
import IzmirIcon from '../../components/IzmirIcon.astro';
import '../../styles/ulasim.css';
import { BASE, otobus, vapur, izban, metro, tramvay } from '../../lib/ulasim';

const popularBus = ['202', '985', '684', '984', '5', '169'].map((no) => otobus.lines.find((l) => l.no === no)).filter(Boolean);

const modes = [
  { href: `${BASE}/otobus/`, title: 'Otobüs Saatleri', sub: `ESHOT · ${otobus.lines.length} hat`, badge: 'ESHOT', icon: 'otobus' },
  { href: `${BASE}/vapur/`, title: 'Vapur Saatleri', sub: `İzdeniz · ${vapur.piers.length} iskele`, badge: 'Vapur', icon: 'vapur' },
  { href: `${BASE}/izban/`, title: 'İZBAN Saatleri', sub: `Banliyö · ${izban.stations.length} istasyon`, badge: 'İZBAN', icon: 'metro' },
  { href: `${BASE}/metro/`, title: 'Metro Sefer Saatleri', sub: `İzmir Metro · ${metro.stations.length} istasyon`, badge: 'Metro', icon: 'metro' },
  { href: `${BASE}/tramvay/`, title: 'Tramvay Sefer Saatleri', sub: 'Konak, Karşıyaka ve Çiğli tramvayları', badge: 'Tramvay', icon: 'metro' },
] as const;
---

<Layout title="İzmir Toplu Taşıma Saatleri" activePage="ulasim" description="İzmir otobüs, vapur, İZBAN, metro ve tramvay sefer saatleri tek sayfada. ESHOT hat saatleri, İzdeniz iskele saatleri ve İZBAN istasyon saatleri her gün güncellenir.">
  <UlasimHeader
    title="Toplu Taşıma Saatleri"
    desc="İzmir'de otobüs, vapur, İZBAN, metro ve tramvay sefer saatleri. Veriler İzmir Büyükşehir Belediyesi'nin açık veri servisinden her gün güncellenir."
  />

  <section class="tt-main">
    <div class="tt-container">
      <div class="tt-section">
        <div class="mode-grid">
          {modes.map((m) => (
            <a href={m.href} class="mode">
              <span class="mode-icon"><IzmirIcon name={m.icon} size={64} /></span>
              <span class="mode-text">
                <span class="mode-title">{m.title}</span>
                <span class="mode-sub">{m.sub}</span>
              </span>
              <span class="tt-arrow">→</span>
            </a>
          ))}
        </div>
      </div>

      <div class="tt-section">
        <h2 class="tt-h2">Sık aranan vapur iskeleleri</h2>
        <div class="tt-list">
          {vapur.piers.slice(0, 5).map((p) => (
            <a href={`${BASE}/vapur/${p.slug}/`} class="tt-row">
              <div class="tt-row-main"><p class="tt-row-title">{p.name} Vapur Saatleri</p></div>
              <span class="tt-arrow">→</span>
            </a>
          ))}
        </div>
      </div>

      {popularBus.length > 0 && (
        <div class="tt-section">
          <h2 class="tt-h2">Sık aranan otobüs hatları</h2>
          <div class="tt-list">
            {popularBus.map((l) => (
              <a href={`${BASE}/otobus/${l!.no}/`} class="tt-row">
                <span class="tt-badge">{l!.no}</span>
                <div class="tt-row-main"><p class="tt-row-title">{l!.name}</p></div>
                <span class="tt-arrow">→</span>
              </a>
            ))}
          </div>
        </div>
      )}

      <p class="tt-note">
        Saatler İzmir Büyükşehir Belediyesi açık veri portalından (ESHOT, İzdeniz, İZBAN, İzmir Metro) alınır ve her gün güncellenir. Bayram, tatil ve yoğun hava koşullarında seferlerde değişiklik olabilir; yolculuktan önce işletmenin resmî duyurularını kontrol edin.
      </p>
    </div>
  </section>
</Layout>

<style>
  .mode-grid { display: grid; gap: 12px; grid-template-columns: 1fr; }
  @media (min-width: 640px) { .mode-grid { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 960px) { .mode-grid { grid-template-columns: repeat(3, 1fr); } }
  .mode {
    display: flex; align-items: center; gap: 14px; padding: 14px 18px 14px 14px; background: #fff;
    border: 1px solid #efe2d3; border-radius: 20px; transition: transform 0.25s, box-shadow 0.25s, border-color 0.25s;
  }
  .mode:hover { transform: translateY(-3px); border-color: #062f96; box-shadow: 0 18px 36px -24px rgba(90,58,26,0.5); color: inherit; }
  .mode-icon { flex-shrink: 0; width: 72px; height: 72px; border-radius: 20px; display: flex; align-items: center; justify-content: center; background: linear-gradient(145deg, #fff 0%, #f3e6d6 100%); box-shadow: inset 0 2px 0 #fff, 0 8px 20px -12px rgba(90,58,26,0.4); }
  .mode-text { flex: 1; display: flex; flex-direction: column; gap: 2px; min-width: 0; }
  .mode-title { font-size: 16px; font-weight: 600; color: #1a1a1a; }
  .mode-sub { font-size: 13px; color: #888; }
</style>
