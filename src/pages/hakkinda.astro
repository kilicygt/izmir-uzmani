---
import Layout from '../layouts/Layout.astro';
import IzmirIcon from '../components/IzmirIcon.astro';

const services = [
  {
    icon: 'saatkulesi', href: '/rehberler', title: 'Gezi Rehberleri',
    desc: 'Kemeraltı’ndan Kadifekale’ye, Efes’ten Şirince’ye; hikayesi, ziyaret ipuçları ve gezi rotalarıyla gezilecek yerler.',
    cta: 'Rehberleri oku',
  },
  {
    icon: 'bilet', href: '/etkinlikler', title: 'Etkinlikler',
    desc: 'Konserler, tiyatrolar, sergiler ve festivaller. Şehirde bu hafta neler olduğunu kaçırmayın.',
    cta: 'Etkinlikleri gör',
  },
  {
    icon: 'harita', href: '/rehberler', title: 'Semtler ve Rotalar',
    desc: 'Alsancak, Karşıyaka, Urla, Çeşme… Yürüyüş rotaları, günübirlik kaçamaklar ve sakin hafta sonu planları.',
    cta: 'Rota bul',
  },
  {
    icon: 'vapur', href: '/toplu-tasima-saatleri', title: 'Şehirde Ulaşım',
    desc: 'Gideceğin yere nasıl ulaşacağını da düşündük: metro, İZBAN, vapur ve otobüs saatleri bir tık uzağında.',
    cta: 'Ulaşıma göz at',
  },
] as const;

const values = [
  { t: 'Yerel bakış', d: 'Bu şehrin sokaklarını, sahillerini ve hikayelerini bilen insanların gözünden yazıyoruz.' },
  { t: 'Her gün yeni içerik', d: 'Yeni rehberler, güncel etkinlikler ve şehirden haberler; İzmir Uzmanı her gün biraz daha büyüyor.' },
  { t: 'Sade ve samimi', d: 'Uzun reklam metinleri yok. Bir arkadaşına anlatır gibi, işine yarayacak olanı yazıyoruz.' },
  { t: 'Herkese ücretsiz', d: 'Üyelik yok, uygulama indirmek yok. İzmir Uzmanı herkese açık ve ücretsizdir.' },
];

const faqs = [
  {
    q: 'İzmir Uzmanı nedir?',
    a: 'İzmir Uzmanı; İzmir’in gezilecek yerlerini, semtlerini, etkinliklerini ve şehir hayatını yerel gözüyle anlatan bağımsız bir şehir rehberidir. 2024’ten beri İzmir’i yaşayanların ve ziyaret edenlerin işine yarayacak bilgileri sade bir dille paylaşıyoruz.',
  },
  {
    q: 'Hangi konularda içerik yayınlıyorsunuz?',
    a: 'İzmir ve çevresinde gezilecek yerler, semtler, tarihi mekanlar, doğa rotaları, günübirlik kaçamaklar ve şehirdeki etkinlikler hakkında rehberler yayınlıyoruz. Ayrıca gideceğiniz yere kolayca ulaşabilmeniz için toplu taşıma saatlerini de sitede bulabilirsiniz.',
  },
  {
    q: 'İzmir Uzmanı resmi bir kurum mu?',
    a: 'Hayır. İzmir Uzmanı herhangi bir belediye ya da ulaşım kuruluşuna bağlı değildir. İzmir’i seven insanların hazırladığı bağımsız bir şehir rehberiyiz.',
  },
  {
    q: 'Bir mekan ya da etkinlik önermek istiyorum, nasıl ulaşabilirim?',
    a: 'Instagram’da @izmiruzmani hesabına mesaj atabilir ya da merhaba@izmiruzmani.com adresine e-posta gönderebilirsiniz. Tüm önerileri okuyoruz.',
  },
];

const igPhotos = [1, 2, 3, 4, 5, 6].map((i) => `/images/instagram/${i}.webp?v=2`);

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'AboutPage',
      '@id': 'https://www.izmiruzmani.com/hakkinda/#webpage',
      url: 'https://www.izmiruzmani.com/hakkinda/',
      name: 'Hakkımızda — İzmir Uzmanı',
      inLanguage: 'tr-TR',
      about: { '@id': 'https://www.izmiruzmani.com/#organization' },
    },
    {
      '@type': 'Organization',
      '@id': 'https://www.izmiruzmani.com/#organization',
      name: 'İzmir Uzmanı',
      alternateName: 'Izmir Uzmani',
      url: 'https://www.izmiruzmani.com/',
      logo: 'https://www.izmiruzmani.com/images/site_logo.png',
      foundingDate: '2024',
      areaServed: { '@type': 'City', name: 'İzmir' },
      sameAs: ['https://www.instagram.com/izmiruzmani/'],
      email: 'merhaba@izmiruzmani.com',
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
  ],
};
---

<Layout
  title="Hakkımızda"
  activePage="hakkinda"
  description="İzmir Uzmanı; İzmir’in gezilecek yerlerini, semtlerini, etkinliklerini ve şehir hayatını yerel gözüyle anlatan bağımsız şehir rehberi. Hikayemizi ve neler yaptığımızı keşfedin."
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <!-- HERO -->
  <section class="hero">
    <div class="blob blob-a"></div>
    <div class="blob blob-b"></div>
    <div class="container hero-grid">
      <div class="hero-text">
        <p class="breadcrumb"><a href="/" class="bc-link">Ana Sayfa</a> · Hakkımızda</p>
        <p class="eyebrow">Hakkımızda</p>
        <h1 class="hero-title">İzmir’i yerel gözüyle anlatıyoruz.</h1>
        <p class="hero-sub">
          Kordon’da gün batımından Kemeraltı’nın ara sokaklarına, Urla’nın bağlarından şehrin konser takvimine…
          İzmir Uzmanı, bu şehri yaşayanların ve keşfetmek isteyenlerin bağımsız şehir rehberi.
        </p>
        <div class="hero-cta">
          <a href="/rehberler" class="btn-primary">Rehberleri keşfet</a>
          <a href="https://instagram.com/izmiruzmani" target="_blank" rel="noopener" class="btn-outline">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1.5" fill="currentColor" stroke="none"/></svg>
            @izmiruzmani
          </a>
        </div>
      </div>

      <div class="hero-art" aria-hidden="true">
        <div class="art-sun"></div>
        <div class="art-disc"></div>
        <div class="art-land"></div>
        <IzmirIcon name="asansor" size={150} class="art art-asansor" />
        <IzmirIcon name="saatkulesi" size={220} class="art art-kule" />
        <IzmirIcon name="palmiye" size={130} class="art art-palm" />
        <IzmirIcon name="marti" size={84} class="art art-marti" />
        <IzmirIcon name="marti" size={54} class="art art-marti2" />
        <IzmirIcon name="vapur" size={170} class="art art-vapur" />
      </div>
    </div>
  </section>

  <!-- STORY -->
  <section class="story">
    <div class="container story-grid">
      <div>
        <p class="eyebrow">Hikayemiz</p>
        <h2 class="h2">İzmir’i ezbere bilenlerin anlattığı bir şehir rehberi olmak için kurulduk.</h2>
      </div>
      <div class="story-body">
        <p>
          Şehir rehberlerinin çoğu aynı mekanları, aynı rotaları tekrar eder. Oysa İzmir çok daha derin: her semtin
          kendine ait bir ritmi, her sokağın ayrı bir hikayesi var. Alsancak’ın akşamları, Karşıyaka çarşısının telaşı,
          Kemeraltı’nın hanları, Çeşme’nin rüzgarı ve Şirince’nin sakinliği aynı şehrin farklı yüzleri.
        </p>
        <p>
          İzmir Uzmanı’nı 2024’te bu hikayeleri anlatmak için kurduk. Gezilecek yerleri, tarihi mekanları, doğa
          rotalarını ve günübirlik kaçamakları; şehri gerçekten yaşayan insanların gözünden, sade ve samimi bir dille yazıyoruz.
        </p>
        <p>
          Amacımız basit: İzmir’de yaşıyorsan şehrini yeniden keşfetmene, ilk kez geliyorsan buranın tadını en iyi şekilde
          çıkarmana yardımcı olmak. Kısacası, İzmir’le ilgili bir şey arıyorsan aklına ilk gelen yer olmak.
        </p>
      </div>
    </div>
  </section>

  <!-- SERVICES -->
  <section class="services">
    <div class="container">
      <p class="eyebrow center">Ne Yapıyoruz?</p>
      <h2 class="h2 center">İzmir için ihtiyacın olan her şey, tek adreste</h2>
      <div class="services-grid">
        {services.map((s) => (
          <a href={s.href} class="svc-card">
            <div class="svc-icon"><IzmirIcon name={s.icon} size={96} /></div>
            <h3 class="svc-title">{s.title}</h3>
            <p class="svc-desc">{s.desc}</p>
            <span class="svc-cta">{s.cta} →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- VALUES -->
  <section class="values">
    <div class="container values-grid">
      <div class="values-head">
        <p class="eyebrow">İlkelerimiz</p>
        <h2 class="h2">Neden İzmir Uzmanı?</h2>
        <p class="muted">Bir şehir rehberinin işe yaraması için doğru, güncel ve kolay ulaşılır olması gerekir. Her sayfayı bu ilkelerle hazırlıyoruz.</p>
      </div>
      <div class="values-list">
        {values.map((v, i) => (
          <div class="value">
            <span class="value-num">0{i + 1}</span>
            <div>
              <h3 class="value-title">{v.t}</h3>
              <p class="value-desc">{v.d}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- INSTAGRAM -->
  <section class="ig">
    <div class="container">
      <div class="ig-card">
        <div class="ig-text">
          <p class="ig-eyebrow">Instagram</p>
          <h2 class="ig-title">İzmir’in güncel hali,<br />her gün akışında.</h2>
          <p class="ig-desc">Yeni rehberler, etkinlik önerileri, gizli köşeler ve şehirden kareler. @izmiruzmani’yi takip et, İzmir’de olan biteni kaçırma.</p>
          <a href="https://instagram.com/izmiruzmani" target="_blank" rel="noopener" class="ig-btn">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1.5" fill="currentColor" stroke="none"/></svg>
            Takip et: @izmiruzmani
          </a>
        </div>
        <a href="https://instagram.com/izmiruzmani" target="_blank" rel="noopener" class="ig-grid" aria-label="İzmir Uzmanı Instagram hesabı">
          {igPhotos.map((src) => <img src={src} alt="" loading="lazy" width="200" height="200" />)}
        </a>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="faq">
    <div class="container faq-wrap">
      <p class="eyebrow center">Sıkça Sorulanlar</p>
      <h2 class="h2 center">Merak edilenler</h2>
      <div class="faq-list">
        {faqs.map((f, i) => (
          <details class="faq-item" open={i === 0}>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- CONTACT -->
  <section class="contact">
    <div class="contact-wrap">
      <IzmirIcon name="marti" size={110} class="contact-bird" />
      <h2 class="h2 center">Soru, öneri ya da iş birliği için</h2>
      <p class="muted center">Bir mekan önerin, etkinliğinizi duyurun ya da sadece merhaba deyin. Her mesajı okuyoruz.</p>
      <div class="contact-btns">
        <a href="mailto:merhaba@izmiruzmani.com" class="btn-primary">E-posta gönder</a>
        <a href="https://instagram.com/izmiruzmani" target="_blank" rel="noopener" class="btn-outline">Instagram’dan yaz</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .container { max-width: 1200px; margin: 0 auto; padding: 0 20px; }
  .eyebrow {
    font-size: 12px; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase;
    color: #062f96; margin-bottom: 16px;
  }
  .center { text-align: center; }
  .h2 {
    font-family: 'Fraunces', serif; font-weight: 700; color: #1a1a1a;
    font-size: clamp(26px, 3.4vw, 38px); line-height: 1.2; letter-spacing: -0.02em; margin-bottom: 18px;
  }
  .muted { color: #666; font-size: 15px; line-height: 1.75; }
  .btn-primary {
    background: #062f96; color: #fff; font-size: 14px; font-weight: 500;
    padding: 13px 26px; border-radius: 10px; display: inline-flex; align-items: center; gap: 8px;
    transition: background 0.2s, transform 0.2s;
  }
  .btn-primary:hover { background: #041e6e; color: #fff; transform: translateY(-1px); }
  .btn-outline {
    background: #fff; color: #1a1a1a; font-size: 14px; font-weight: 500;
    padding: 12px 24px; border-radius: 10px; display: inline-flex; align-items: center; gap: 8px;
    border: 1.5px solid #e4d9cd; transition: border-color 0.2s, transform 0.2s;
  }
  .btn-outline:hover { border-color: #999; color: #1a1a1a; transform: translateY(-1px); }

  /* HERO */
  .hero {
    position: relative; overflow: hidden;
    background: linear-gradient(180deg, #fff9f3 0%, #f5e8d8 100%);
    padding: clamp(40px, 7vw, 88px) 0 clamp(48px, 7vw, 80px);
  }
  .blob { position: absolute; border-radius: 50%; filter: blur(64px); pointer-events: none; }
  .blob-a { top: -80px; right: -80px; width: 460px; height: 460px; background: rgba(255,124,17,0.12); animation: floatA 10s ease-in-out infinite; }
  .blob-b { bottom: -120px; left: -80px; width: 420px; height: 420px; background: rgba(6,47,150,0.08); animation: floatB 13s ease-in-out infinite; }
  .hero-grid { position: relative; display: grid; gap: 32px; align-items: center; }
  @media (min-width: 900px) { .hero-grid { grid-template-columns: 1.05fr 1fr; gap: 48px; } }
  .hero-text { animation: fadeUp 0.6s ease both; }
  .breadcrumb { font-size: 12px; color: #999; margin-bottom: 28px; }
  .bc-link { color: #062f96; }
  .hero-title {
    font-family: 'Fraunces', serif; font-weight: 800; color: #1a1a1a;
    font-size: clamp(40px, 6.2vw, 70px); line-height: 1.04; letter-spacing: -0.03em; margin-bottom: 22px;
  }
  .hero-sub { font-size: 17px; color: #555; line-height: 1.75; max-width: 520px; margin-bottom: 32px; }
  .hero-cta { display: flex; gap: 12px; flex-wrap: wrap; }

  .hero-art { position: relative; height: clamp(320px, 42vw, 460px); max-width: 520px; width: 100%; margin: 0 auto; }
  .art-sun {
    position: absolute; top: 6%; right: 10%; width: 26%; aspect-ratio: 1; border-radius: 50%;
    background: radial-gradient(circle at 35% 35%, #ffd08a, #ff8c2b 70%);
    box-shadow: 0 0 60px rgba(255,140,43,0.45);
  }
  .art-disc {
    position: absolute; left: 6%; right: 6%; bottom: 6%; height: 58%; border-radius: 50% 50% 46% 46%;
    background: linear-gradient(180deg, #8fb0f5 0%, #3f6fdc 100%);
    box-shadow: inset 0 -18px 40px rgba(6,47,150,0.25), 0 30px 60px -30px rgba(6,47,150,0.45);
  }
  .art-land {
    position: absolute; left: 12%; right: 12%; bottom: 25%; height: 26%; border-radius: 50%;
    background: linear-gradient(180deg, #fbe7c8 0%, #ecc993 100%);
    box-shadow: 0 10px 0 #d9ad6e, 0 22px 30px -10px rgba(6,47,150,0.4);
  }
  :global(.art) { position: absolute; filter: drop-shadow(0 18px 18px rgba(90,58,26,0.18)); }
  :global(.art-kule) { left: 35%; bottom: 27%; width: 42%; height: auto; animation: bob 6s ease-in-out infinite; }
  :global(.art-asansor) { left: 9%; bottom: 31%; width: 28%; height: auto; animation: bob 7s ease-in-out infinite 0.6s; }
  :global(.art-palm) { right: 9%; bottom: 31%; width: 25%; height: auto; animation: bob 6.5s ease-in-out infinite 1.2s; }
  :global(.art-vapur) { right: 30%; bottom: 2%; width: 34%; height: auto; animation: sail 8s ease-in-out infinite; }
  :global(.art-marti) { left: 14%; top: 6%; width: 17%; height: auto; animation: fly 9s ease-in-out infinite; }
  :global(.art-marti2) { left: 40%; top: 0; width: 11%; height: auto; animation: fly 11s ease-in-out infinite 1s; }
  @keyframes bob { 0%,100% { transform: translateY(0); } 50% { transform: translateY(-8px); } }
  @keyframes sail { 0%,100% { transform: translate(0,0) rotate(0); } 50% { transform: translate(-10px,-4px) rotate(-2deg); } }
  @keyframes fly { 0%,100% { transform: translate(0,0); } 50% { transform: translate(18px,-10px); } }
  @media (prefers-reduced-motion: reduce) { :global(.art), .blob { animation: none !important; } }

  /* STORY */
  .story { background: #fff9f3; padding: clamp(56px, 8vw, 104px) 0; }
  .story-grid { display: grid; gap: 24px; }
  @media (min-width: 900px) { .story-grid { grid-template-columns: 1fr 1.2fr; gap: 64px; } }
  .story-body p { font-size: 16px; color: #555; line-height: 1.85; margin-bottom: 18px; }

  /* SERVICES */
  .services { background: #f0e8df; padding: clamp(56px, 8vw, 96px) 0; }
  .services-grid { display: grid; gap: 20px; margin-top: 36px; }
  @media (min-width: 640px) { .services-grid { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 1024px) { .services-grid { grid-template-columns: repeat(4, 1fr); } }
  .svc-card {
    background: #fff9f3; border-radius: 20px; padding: 26px 24px 24px; border: 1px solid rgba(0,0,0,0.05);
    display: flex; flex-direction: column; transition: transform 0.25s, box-shadow 0.25s;
  }
  .svc-card:hover { transform: translateY(-4px); box-shadow: 0 20px 40px -20px rgba(90,58,26,0.35); color: inherit; }
  .svc-icon {
    width: 112px; height: 112px; border-radius: 28px; margin-bottom: 18px;
    background: linear-gradient(145deg, #fff 0%, #f3e6d6 100%);
    box-shadow: inset 0 2px 0 #fff, 0 10px 24px -12px rgba(90,58,26,0.35);
    display: flex; align-items: center; justify-content: center;
  }
  .svc-card:hover .svc-icon :global(svg) { transform: scale(1.06) rotate(-3deg); }
  .svc-icon :global(svg) { transition: transform 0.3s; }
  .svc-title { font-size: 17px; font-weight: 600; color: #1a1a1a; margin-bottom: 8px; }
  .svc-desc { font-size: 14px; color: #666; line-height: 1.7; flex: 1; }
  .svc-cta { margin-top: 16px; font-size: 14px; font-weight: 600; color: #062f96; }

  /* VALUES */
  .values { background: #fff9f3; padding: clamp(56px, 8vw, 96px) 0; }
  .values-grid { display: grid; gap: 32px; }
  @media (min-width: 900px) { .values-grid { grid-template-columns: 1fr 1.3fr; gap: 64px; } }
  .values-list { display: grid; gap: 14px; }
  @media (min-width: 640px) { .values-list { grid-template-columns: 1fr 1fr; } }
  .value { display: flex; gap: 14px; padding: 20px; border-radius: 16px; background: #fff; border: 1px solid #f0e4d6; }
  .value-num { font-family: 'Fraunces', serif; font-weight: 800; font-size: 22px; color: #ff7c11; line-height: 1.2; }
  .value-title { font-size: 16px; font-weight: 600; margin-bottom: 4px; }
  .value-desc { font-size: 14px; color: #666; line-height: 1.65; }

  /* INSTAGRAM */
  .ig { background: #fff9f3; padding: 0 0 clamp(56px, 8vw, 96px); }
  .ig-card {
    border-radius: 28px; overflow: hidden; display: grid; gap: 28px; align-items: center;
    padding: clamp(28px, 5vw, 56px);
    background: linear-gradient(135deg, #f58529 0%, #dd2a7b 45%, #8134af 75%, #515bd4 100%);
    box-shadow: 0 30px 60px -30px rgba(129,52,175,0.6);
  }
  @media (min-width: 900px) { .ig-card { grid-template-columns: 1fr 1fr; gap: 48px; } }
  .ig-eyebrow { font-size: 12px; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: rgba(255,255,255,0.8); margin-bottom: 12px; }
  .ig-title { font-family: 'Fraunces', serif; font-weight: 800; font-size: clamp(28px, 4vw, 44px); line-height: 1.1; color: #fff; margin-bottom: 16px; }
  .ig-desc { color: rgba(255,255,255,0.9); font-size: 15px; line-height: 1.75; margin-bottom: 26px; max-width: 460px; }
  .ig-btn {
    display: inline-flex; align-items: center; gap: 10px; background: #fff; color: #1a1a1a;
    font-weight: 600; font-size: 15px; padding: 14px 24px; border-radius: 999px; transition: transform 0.2s;
  }
  .ig-btn:hover { transform: translateY(-2px); color: #dd2a7b; }
  .ig-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; transform: rotate(2deg); }
  .ig-grid img {
    width: 100%; aspect-ratio: 1; object-fit: cover; border-radius: 12px; display: block;
    border: 3px solid rgba(255,255,255,0.9); box-shadow: 0 10px 20px -10px rgba(0,0,0,0.4);
  }

  /* FAQ */
  .faq { background: #f0e8df; padding: clamp(56px, 8vw, 96px) 0; }
  .faq-wrap { max-width: 800px; }
  .faq-list { margin-top: 32px; display: grid; gap: 12px; }
  .faq-item { background: #fff9f3; border-radius: 14px; border: 1px solid rgba(0,0,0,0.05); padding: 0 22px; }
  .faq-item summary {
    cursor: pointer; list-style: none; padding: 18px 0; font-weight: 600; font-size: 16px;
