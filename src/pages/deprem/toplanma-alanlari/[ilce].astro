---
import Layout from '../../../layouts/Layout.astro';
import NearestToplanma from '../../../components/NearestToplanma.astro';
import data from '../../../data/toplanma.json';
import { ilceSlug } from '../../../lib/eczane-core.mjs';

export function getStaticPaths() {
  return [...new Set(data.areas.map((a) => a.i))].map((ilce) => ({ params: { ilce: ilceSlug(ilce) }, props: { ilce } }));
}
const { ilce } = Astro.props as { ilce: string };
const areas = data.areas.filter((a) => a.i === ilce);
const byMahalle = [...areas.reduce((m, a) => m.set(a.m, [...(m.get(a.m) ?? []), a]), new Map<string, typeof areas>())]
  .sort((a, b) => a[0].localeCompare(b[0], 'tr'));
const others = [...new Set(data.areas.map((a) => a.i))].filter((i) => i !== ilce).sort((a, b) => a.localeCompare(b, 'tr'));
---

<Layout
  title={`${ilce} Afet Toplanma Alanları`}
  description={`${ilce} ilçesindeki ${areas.length} afet ve acil durum toplanma alanı, ${byMahalle.length} mahalle için adres ve yol tarifiyle. En yakın toplanma alanını bul.`}
>
  <section class="hero">
    <div class="container">
      <p class="breadcrumb"><a href="/">Ana Sayfa</a><span>›</span><a href="/deprem/">Deprem</a><span>›</span><a href="/deprem/toplanma-alanlari/">Toplanma Alanları</a><span>›</span>{ilce}</p>
      <h1 class="title">{ilce} Afet Toplanma Alanları</h1>
      <p class="desc">{ilce}’da {byMahalle.length} mahallede {areas.length} resmi afet ve acil durum toplanma alanı var. Mahalleni aşağıda bulabilir ya da en yakın alanı konumunla görebilirsin.</p>
      <NearestToplanma />
    </div>
  </section>

  <section class="main">
    <div class="container">
      <label class="search">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
        <input type="search" placeholder="Mahalle ya da sokak ara…" data-q aria-label="Mahalle ara" />
      </label>
      <div class="mah-list">
        {byMahalle.map(([m, list]) => (
          <section class="mah" data-mah data-text={`${m} ${list.map((a) => a.s).join(' ')}`.toLocaleLowerCase('tr')}>
            <h2 class="mah-title">{m} Mahallesi <span>{list.length}</span></h2>
            <ul>
              {list.map((a) => (
                <li>
                  <div>
                    <p class="a-name">{a.n}</p>
                    {a.s && <p class="a-addr">{a.s}</p>}
                  </div>
                  <a class="a-go" href={`https://www.google.com/maps/dir/?api=1&destination=${a.la},${a.lo}&travelmode=walking`} target="_blank" rel="noopener">Yol tarifi</a>
                </li>
              ))}
            </ul>
          </section>
        ))}
      </div>
      <p class="empty" data-empty hidden>Aramanla eşleşen mahalle yok.</p>

      <h2 class="sec-title">Diğer ilçeler</h2>
      <div class="chips">{others.map((i) => <a href={`/deprem/toplanma-alanlari/${ilceSlug(i)}/`}>{i}</a>)}</div>
      <p class="note">Kaynak: İzmir Büyükşehir Belediyesi açık verisi. Resmî sorgulama için <a href="https://www.turkiye.gov.tr/afet-ve-acil-durum-yonetimi-acil-toplanma-alani-sorgulama" target="_blank" rel="noopener">e-Devlet</a>. <a href="/deprem/">İzmir son depremler →</a></p>
    </div>
  </section>
</Layout>

<style>
  .container { max-width: 1100px; margin: 0 auto; padding: 0 20px; }
  .hero { background: linear-gradient(180deg, #fff9f3 0%, #e7f6ef 100%); padding: clamp(28px, 5vw, 52px) 0 clamp(26px, 4vw, 40px); }
  .breadcrumb { font-size: 12px; color: #999; margin-bottom: 14px; display: flex; gap: 6px; flex-wrap: wrap; }
  .breadcrumb a { color: #062f96; }
  .title { font-family: 'Fraunces', serif; font-weight: 800; font-size: clamp(28px, 4.6vw, 48px); line-height: 1.05; letter-spacing: -0.02em; margin-bottom: 12px; }
  .desc { font-size: 15.5px; color: #555; line-height: 1.7; max-width: 640px; margin-bottom: 18px; }
  .main { background: #fff9f3; padding: clamp(24px, 4vw, 40px) 0 clamp(48px, 6vw, 72px); }
  .search { display: flex; align-items: center; gap: 8px; background: #fff; border: 1.5px solid #e4d9cd; border-radius: 999px; padding: 0 16px; color: #062f96; max-width: 460px; margin-bottom: 18px; }
  .search input { flex: 1; border: 0; outline: 0; background: transparent; font: 500 14px 'Poppins', sans-serif; padding: 12px 0; }
  .mah-list { display: grid; gap: 12px; grid-template-columns: 1fr; }
  @media (min-width: 760px) { .mah-list { grid-template-columns: 1fr 1fr; } }
  .mah { background: #fff; border: 1px solid #efe2d3; border-radius: 18px; padding: 14px 16px; }
  .mah[hidden], .empty[hidden] { display: none; }
  .mah-title { font-size: 16px; font-weight: 600; margin-bottom: 8px; display: flex; align-items: center; gap: 8px; }
  .mah-title span { font-size: 12px; color: #0b7a5c; background: #e3f5ee; border-radius: 999px; padding: 2px 8px; }
  .mah ul { list-style: none; padding: 0; margin: 0; }
  .mah li { display: flex; justify-content: space-between; align-items: center; gap: 10px; padding: 8px 0; border-top: 1px solid #f3ebe1; }
  .a-name { font-size: 14px; font-weight: 500; }
  .a-addr { font-size: 12.5px; color: #888; }
  .a-go { flex-shrink: 0; font-size: 12.5px; font-weight: 600; color: #fff; background: #0b7a5c; border-radius: 10px; padding: 7px 12px; }
  .a-go:hover { background: #086349; color: #fff; }
  .empty { background: #fff; border: 1px dashed #e4d9cd; border-radius: 16px; padding: 16px; color: #666; }
  .sec-title { font-family: 'Fraunces', serif; font-weight: 700; font-size: 22px; margin: 36px 0 12px; }
  .chips { display: flex; flex-wrap: wrap; gap: 6px; }
  .chips a { background: #fff; border: 1px solid #efe2d3; border-radius: 999px; padding: 7px 14px; font-size: 13.5px; }
  .chips a:hover { border-color: #0b7a5c; color: #0b7a5c; }
  .note { margin-top: 28px; background: #f0e8df; border-radius: 16px; padding: 14px 18px; font-size: 13.5px; color: #555; line-height: 1.65; }
  .note a { color: #062f96; text-decoration: underline; }
</style>

<script>
  const q = document.querySelector<HTMLInputElement>('[data-q]');
  q?.addEventListener('input', () => {
    const t = q.value.toLocaleLowerCase('tr').trim();
    let shown = 0;
    document.querySelectorAll<HTMLElement>('[data-mah]').forEach((m) => {
      const ok = !t || (m.dataset.text ?? '').includes(t);
      m.hidden = !ok;
      if (ok) shown++;
    });
    document.querySelector('[data-empty]')?.toggleAttribute('hidden', shown > 0);
  });
</script>
