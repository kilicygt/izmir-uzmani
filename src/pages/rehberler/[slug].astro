---
import Layout from '../../layouts/Layout.astro';
import IzmirIcon from '../../components/IzmirIcon.astro';
import { getCollection } from 'astro:content';
import { themeOf, postImage, shortDate } from '../../lib/themes';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await post.render();
const theme = themeOf(post.data.category);
const img = postImage(post);

const allPosts = await getCollection('blog');
const byDate = (a: typeof post, b: typeof post) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf();
const others = allPosts.filter(p => p.slug !== post.slug).sort(byDate);
const sameTheme = others.filter(p => themeOf(p.data.category).key === theme.key);
const related = [...sameTheme, ...others.filter(p => !sameTheme.includes(p))].slice(0, 3);

const toc = headings.filter(h => h.depth === 2);
const pubDateStr = post.data.pubDate.toLocaleDateString('tr-TR', { day: 'numeric', month: 'long', year: 'numeric' });
const pageUrl = new URL(`/rehberler/${post.slug}/`, Astro.site).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BlogPosting',
      headline: post.data.title,
      description: post.data.description,
      image: new URL(img.replace(/\?.*$/, ''), Astro.site).href,
      datePublished: post.data.pubDate.toISOString(),
      inLanguage: 'tr-TR',
      mainEntityOfPage: pageUrl,
      author: { '@type': 'Organization', name: 'İzmir Uzmanı', url: 'https://www.izmiruzmani.com/' },
      publisher: {
        '@type': 'Organization',
        name: 'İzmir Uzmanı',
        logo: { '@type': 'ImageObject', url: 'https://www.izmiruzmani.com/images/site_logo.png' },
      },
      ...(post.data.tags?.length ? { keywords: post.data.tags.join(', ') } : {}),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Ana Sayfa', item: 'https://www.izmiruzmani.com/' },
        { '@type': 'ListItem', position: 2, name: 'Rehberler', item: 'https://www.izmiruzmani.com/rehberler/' },
        { '@type': 'ListItem', position: 3, name: post.data.title, item: pageUrl },
      ],
    },
  ],
};
---

<Layout
  title={post.data.title}
  description={post.data.description}
  activePage="rehberler"
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')} />

  <!-- ARTICLE HEADER -->
  <header class="art-header">
    <div class="wrap anim">
      <p class="breadcrumb">
        <a href="/" class="bc-link">Ana Sayfa</a>
        <span>›</span> <a href="/rehberler" class="bc-link">Rehberler</a>
        <span>›</span> {theme.label}
      </p>
      <span class="tag" style={`background:${theme.color}`}>{theme.label}</span>
      <h1 class="art-title">{post.data.title}</h1>
      <p class="art-lead">{post.data.description}</p>
      <div class="art-meta">
        <span class="author">
          <span class="avatar"><IzmirIcon name="saatkulesi" size={30} /></span>
          İzmir Uzmanı
        </span>
        <span class="sep"></span>
        <span>{pubDateStr}</span>
        <span class="sep"></span>
        <span>{post.data.readTime} okuma</span>
      </div>
    </div>
  </header>

  <!-- FEATURED IMAGE -->
  <div class="wrap">
    <figure class="art-img">
      <img
        src={img}
        alt={post.data.imageAlt || post.data.title}
        onerror="this.style.display='none'"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
    </figure>
  </div>

  <!-- BODY -->
  <div class="wrap body-grid">
    <article class="art-content">
      {toc.length > 2 && (
        <details class="toc-mobile">
          <summary>İçindekiler</summary>
          <ol>{toc.map(h => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
        </details>
      )}
      <Content />

      {post.data.tags && post.data.tags.length > 0 && (
        <div class="tags">
          {post.data.tags.map(tag => <span class="tag-chip">#{tag}</span>)}
        </div>
      )}

      <a href="https://instagram.com/izmiruzmani" target="_blank" rel="noopener" class="end-cta">
        <div>
          <p class="end-title">Bu rehberi beğendin mi?</p>
          <p class="end-desc">İzmir’den yeni rotalar ve gizli köşeler için @izmiruzmani’yi takip et.</p>
        </div>
        <span class="end-btn">Takip et →</span>
      </a>
    </article>

    <aside class="sidebar">
      <div class="side-sticky">
        {toc.length > 2 && (
          <nav class="toc" aria-label="İçindekiler">
            <p class="side-label">İçindekiler</p>
            <ol>{toc.map(h => <li><a href={`#${h.slug}`} data-toc={h.slug}>{h.text}</a></li>)}</ol>
          </nav>
        )}
        <a href="/rehberler" class="side-card">
          <IzmirIcon name={theme.icon} size={56} />
          <div>
            <p class="side-card-title">Daha fazla {theme.label.toLocaleLowerCase('tr')}</p>
            <p class="side-card-desc">Tüm rehberlere göz at →</p>
          </div>
        </a>
      </div>
    </aside>
  </div>

  <!-- RELATED -->
  {related.length > 0 && (
    <section class="related-section">
      <div class="container">
        <h2 class="related-heading">Bunlar da ilgini çekebilir</h2>
        <div class="related-grid">
          {related.map(rp => {
            const t = themeOf(rp.data.category);
            return (
              <a href={`/rehberler/${rp.slug}`} class="card">
                <div class="card-img">
                  <img src={postImage(rp)} alt={rp.data.imageAlt || rp.data.title} loading="lazy" decoding="async" onerror="this.style.display='none'" />
                  <span class="tag on-img" style={`background:${t.color}`}>{t.label}</span>
                </div>
                <div class="card-body">
                  <h3 class="card-title">{rp.data.title}</h3>
                  <p class="card-meta">{shortDate(rp.data.pubDate)} · {rp.data.readTime} okuma <span class="arrow">→</span></p>
                </div>
              </a>
            );
          })}
        </div>
      </div>
    </section>
  )}

</Layout>

<style>
  .container { max-width: 1200px; margin: 0 auto; padding: 0 20px; }
  .wrap { max-width: 1100px; margin: 0 auto; padding: 0 20px; }
  .anim { animation: fadeUp 0.5s ease both; }
  .tag { display: inline-block; color: #fff; font-size: 11px; font-weight: 600; padding: 4px 12px; border-radius: 999px; }

  /* HEADER */
  .art-header { background: linear-gradient(180deg, #fff9f3 0%, #f7ece0 100%); padding: clamp(28px, 5vw, 56px) 0 clamp(28px, 4vw, 40px); }
  .art-header .wrap > * { max-width: 820px; }
  .breadcrumb { font-size: 12px; color: #999; margin-bottom: 18px; display: flex; gap: 6px; flex-wrap: wrap; }
  .bc-link { color: #062f96; }
  .art-title {
    font-family: 'Fraunces', serif; font-weight: 800; color: #1a1a1a;
    font-size: clamp(30px, 4.6vw, 52px); line-height: 1.1; letter-spacing: -0.02em; margin: 16px 0 16px;
  }
  .art-lead { font-size: clamp(16px, 1.6vw, 19px); color: #555; line-height: 1.7; margin-bottom: 22px; }
  .art-meta { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; font-size: 13px; color: #888; }
  .author { display: inline-flex; align-items: center; gap: 8px; font-weight: 600; color: #1a1a1a; }
  .avatar { width: 34px; height: 34px; border-radius: 50%; background: #fff; border: 1px solid #ecdccb; display: inline-flex; align-items: center; justify-content: center; }
  .sep { width: 4px; height: 4px; background: #d4ccc4; border-radius: 50%; }

  /* IMAGE */
  .art-img {
    margin: 0 0 clamp(28px, 4vw, 48px); border-radius: 24px; overflow: hidden; aspect-ratio: 16 / 9;
    background: linear-gradient(135deg, #ede5db 0%, #d4c8bc 100%);
    box-shadow: 0 30px 60px -36px rgba(90,58,26,0.55);
  }
  .art-img img { width: 100%; height: 100%; object-fit: cover; display: block; }

  /* BODY */
  .body-grid { display: grid; gap: 48px; padding-bottom: clamp(48px, 6vw, 80px); }
  @media (min-width: 1000px) { .body-grid { grid-template-columns: minmax(0, 700px) 1fr; gap: 64px; } }
  .art-content { min-width: 0; }
  .art-content :global(p) { font-size: 17.5px; color: #333; line-height: 1.85; margin-bottom: 22px; text-wrap: pretty; }
  .art-content :global(h2) {
    font-family: 'Fraunces', serif; font-weight: 700; font-size: clamp(23px, 2.4vw, 28px); line-height: 1.25;
    color: #1a1a1a; margin: 44px 0 16px; letter-spacing: -0.01em; scroll-margin-top: 90px;
  }
  .art-content :global(h3) { font-size: 18px; font-weight: 600; color: #1a1a1a; margin: 30px 0 12px; scroll-margin-top: 90px; }
  .art-content :global(blockquote) {
    margin: 36px 0; padding: 22px 26px; background: #fff; border: 1px solid #efe2d3;
    border-left: 4px solid #ff7c11; border-radius: 0 16px 16px 0;
  }
  .art-content :global(blockquote p) { font-size: 17px; font-weight: 500; color: #1a1a1a; line-height: 1.65; margin-bottom: 0; }
  .art-content :global(ul), .art-content :global(ol) { padding-left: 4px; margin-bottom: 24px; list-style: none; }
  .art-content :global(ol) { counter-reset: li; }
  .art-content :global(li) { position: relative; padding-left: 26px; font-size: 17px; color: #444; line-height: 1.8; margin-bottom: 8px; }
  .art-content :global(ul > li)::before { content: ''; position: absolute; left: 6px; top: 0.72em; width: 7px; height: 7px; border-radius: 50%; background: #ff7c11; }
  .art-content :global(ol > li) { counter-increment: li; }
  .art-content :global(ol > li)::before { content: counter(li); position: absolute; left: 0; top: 0.15em; font-size: 12px; font-weight: 700; color: #062f96; background: #e8eefc; width: 20px; height: 20px; border-radius: 50%; display: flex; align-items: center; justify-content: center; }
  .art-content :global(a) { color: #062f96; text-decoration: underline; text-underline-offset: 3px; }
  .art-content :global(strong) { font-weight: 600; color: #1a1a1a; }
  .art-content :global(table) { width: 100%; border-collapse: collapse; margin: 0 0 24px; font-size: 15px; display: block; overflow-x: auto; }
  .art-content :global(th), .art-content :global(td) { border: 1px solid #efe2d3; padding: 10px 12px; text-align: left; }
  .art-content :global(th) { background: #f7ece0; font-weight: 600; }
  .art-content :global(img) { max-width: 100%; border-radius: 16px; }

  .toc-mobile { background: #fff; border: 1px solid #efe2d3; border-radius: 16px; padding: 4px 18px; margin-bottom: 28px; }
  @media (min-width: 1000px) { .toc-mobile { display: none; } }
  .toc-mobile summary { cursor: pointer; font-weight: 600; padding: 12px 0; }
  .toc-mobile ol, .toc ol { list-style: none; padding: 0 0 8px; margin: 0; }
  .toc-mobile li, .toc li { padding: 0; margin: 0; font-size: 14px; line-height: 1.5; }
  .toc-mobile li::before, .toc li::before { display: none; }
  .toc-mobile a, .toc a { display: block; padding: 6px 0; color: #555; text-decoration: none; }

  .tags { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 36px; padding-top: 28px; border-top: 1px solid #ede5db; }
  .tag-chip { font-size: 12.5px; color: #555; padding: 5px 13px; border-radius: 999px; background: #fff; border: 1px solid #e4d9cd; }

  .end-cta {
    margin-top: 32px; display: flex; gap: 18px; align-items: center; justify-content: space-between; flex-wrap: wrap;
    padding: 22px 24px; border-radius: 20px; color: #fff; text-decoration: none !important;
    background: linear-gradient(135deg, #f58529 0%, #dd2a7b 50%, #8134af 100%);
  }
  .end-cta:hover { color: #fff; }
  .end-title { font-family: 'Fraunces', serif; font-weight: 700; font-size: 20px; margin: 0 0 4px !important; color: #fff !important; }
  .end-desc { font-size: 14px !important; margin: 0 !important; color: rgba(255,255,255,0.9) !important; line-height: 1.6 !important; }
  .end-btn { background: #fff; color: #1a1a1a; font-weight: 600; font-size: 14px; padding: 10px 18px; border-radius: 999px; white-space: nowrap; }

  .sidebar { display: none; }
  @media (min-width: 1000px) { .sidebar { display: block; } }
  .side-sticky { position: sticky; top: 96px; display: grid; gap: 16px; }
  .toc { background: #fff; border: 1px solid #efe2d3; border-radius: 18px; padding: 18px 20px 10px; max-height: 60vh; overflow-y: auto; }
  .side-label { font-size: 11px; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: #999; margin-bottom: 8px; }
  .toc a { border-left: 2px solid transparent; padding-left: 12px; margin-left: -2px; transition: color 0.2s, border-color 0.2s; }
  .toc a:hover, .toc a.active { color: #062f96; border-left-color: #062f96; }
  .side-card { display: flex; gap: 12px; align-items: center; background: #f7ece0; border-radius: 18px; padding: 14px 16px; transition: transform 0.2s; }
  .side-card:hover { transform: translateY(-2px); color: inherit; }
  .side-card-title { font-weight: 600; font-size: 14px; }
  .side-card-desc { font-size: 13px; color: #062f96; }

  /* RELATED */
  .related-section { background: #f0e8df; padding: clamp(40px, 6vw, 72px) 0; }
  .related-heading { font-family: 'Fraunces', serif; font-weight: 700; font-size: clamp(22px, 2.8vw, 30px); color: #1a1a1a; margin-bottom: 24px; }
  .related-grid { display: grid; grid-template-columns: 1fr; gap: 20px; }
  @media (min-width: 700px) { .related-grid { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 1024px) { .related-grid { grid-template-columns: 1fr 1fr 1fr; gap: 24px; } }
  .card { background: #fff; border-radius: 20px; overflow: hidden; border: 1px solid rgba(0,0,0,0.05); display: flex; flex-direction: column; transition: transform 0.25s, box-shadow 0.25s; }
  .card:hover { transform: translateY(-4px); box-shadow: 0 22px 44px -24px rgba(90,58,26,0.45); color: inherit; }
  .card-img { position: relative; aspect-ratio: 16 / 10; background: linear-gradient(135deg, #ede5db 0%, #ddd0c4 100%); overflow: hidden; }
  .card-img img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .tag.on-img { position: absolute; top: 12px; left: 12px; }
  .card-body { padding: 16px 18px 18px; }
  .card-title { font-size: 16px; font-weight: 600; color: #1a1a1a; line-height: 1.4; margin-bottom: 10px; }
  .card-meta { font-size: 12px; color: #999; display: flex; gap: 6px; align-items: center; }
  .arrow { margin-left: auto; color: #062f96; font-size: 16px; }
</style>

<script>
  // Highlight the section being read in the sidebar table of contents.
  const links = document.querySelectorAll<HTMLAnchorElement>('.toc a[data-toc]');
  if (links.length && 'IntersectionObserver' in window) {
    const byId = new Map([...links].map((a) => [a.dataset.toc, a]));
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        if (!e.isIntersecting) return;
        links.forEach((a) => a.classList.remove('active'));
        byId.get(e.target.id)?.classList.add('active');
      });
    }, { rootMargin: '-90px 0px -70% 0px' });
    byId.forEach((_, id) => { const h = id && document.getElementById(id); if (h) io.observe(h); });
  }
</script>
