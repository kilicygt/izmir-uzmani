---
import Layout from '../../layouts/Layout.astro';
import IzmirIcon from '../../components/IzmirIcon.astro';
import { getCollection } from 'astro:content';
import { THEMES, themeOf, postImage, shortDate } from '../../lib/themes';

const allPosts = await getCollection('blog');
const sorted = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());


const posts = sorted.map((p) => ({
  ...p,
  theme: themeOf(p.data.category),
  img: postImage(p),
  search: [p.data.title, p.data.description, p.data.category, ...(p.data.tags ?? [])].join(' ').toLocaleLowerCase('tr'),
}));
const counts = Object.fromEntries(THEMES.map((t) => [t.key, posts.filter((p) => p.theme.key === t.key).length]));
const themes = THEMES.filter((t) => counts[t.key] > 0);

const [lead, ...restFeatured] = posts.slice(0, 3);
const popular = ['Çeşme', 'Alaçatı', 'Urla', 'Efes', 'Bergama', 'Kemeraltı', 'Şirince', 'Seferihisar', 'Karşıyaka', 'Foça'];
---

<Layout
  title="İzmir Gezi Rehberleri"
  activePage="rehberler"
  description="İzmir'de gezilecek yerler, tarihi mekanlar, semtler, doğa rotaları ve günübirlik kaçamaklar. Yerel gözüyle hazırlanmış İzmir gezi rehberleri."
>

  <!-- HERO -->
  <section class="hero">
    <div class="blob blob-a"></div>
    <div class="blob blob-b"></div>
    <div class="container hero-grid">
      <div class="hero-text">
        <p class="breadcrumb"><a href="/" class="bc-link">Ana Sayfa</a> · Rehberler</p>
        <p class="eyebrow">{posts.length} rehber · her gün yenisi</p>
        <h1 class="hero-title">İzmir’i keşfetmenin en kolay yolu.</h1>
        <p class="hero-sub">Gezilecek yerler, tarihi mekanlar, semtler ve günübirlik kaçamaklar. Hepsi şehri bilenlerin gözünden.</p>
        <label class="search">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
          <input id="q" type="search" placeholder="Ara: Çeşme, Efes, Kemeraltı…" autocomplete="off" aria-label="Rehberlerde ara" />
        </label>
        <div class="popular">
          <span class="pop-label">Popüler:</span>
          {popular.map((p) => <button class="pop" data-q={p}>{p}</button>)}
        </div>
      </div>
      <div class="hero-art" aria-hidden="true">
        <div class="art-disc"></div>
        <IzmirIcon name="harita" size={200} class="art art-harita" />
        <IzmirIcon name="saatkulesi" size={150} class="art art-kule" />
        <IzmirIcon name="palmiye" size={120} class="art art-palm" />
        <IzmirIcon name="marti" size={70} class="art art-marti" />
      </div>
    </div>
  </section>

  <!-- THEMES -->
  <section class="themes">
    <div class="container">
      <h2 class="sec-title">Ne keşfetmek istersin?</h2>
      <div class="chips theme-chips">
        <button class="chip active" data-theme="" data-jump>Tümü</button>
        {themes.map((t) => (
          <button class="chip" data-theme={t.key} data-jump><span class="dot" style={`background:${t.color}`}></span>{t.label}</button>
        ))}
      </div>
      <div class="theme-grid">
        {themes.map((t) => (
          <button class="theme" data-theme-pick={t.key} style={`--c:${t.color}`}>
            <span class="theme-icon"><IzmirIcon name={t.icon} size={72} /></span>
            <span class="theme-text">
              <span class="theme-name">{t.label}</span>
              <span class="theme-desc">{t.desc}</span>
              <span class="theme-count">{counts[t.key]} rehber</span>
            </span>
          </button>
        ))}
      </div>
    </div>
  </section>

  <!-- FEATURED -->
  {lead && (
    <section class="featured" id="featured">
      <div class="container">
        <h2 class="sec-title">Yeni eklenenler</h2>
        <div class="feat-grid">
          <a href={`/rehberler/${lead.slug}`} class="feat-lead">
            <img src={lead.img} alt={lead.data.imageAlt || lead.data.title} loading="eager" decoding="async" />
            <div class="feat-overlay">
              <span class="tag" style={`background:${lead.theme.color}`}>{lead.theme.label}</span>
              <h3 class="feat-title">{lead.data.title}</h3>
              <p class="feat-desc">{lead.data.description}</p>
              <p class="feat-meta">{shortDate(lead.data.pubDate)} · {lead.data.readTime} okuma</p>
            </div>
          </a>
          <div class="feat-side">
            {restFeatured.map((p) => (
              <a href={`/rehberler/${p.slug}`} class="feat-small">
                <div class="fs-img"><img src={p.img} alt={p.data.imageAlt || p.data.title} loading="eager" decoding="async" /></div>
                <div>
                  <span class="tag" style={`background:${p.theme.color}`}>{p.theme.label}</span>
                  <h3 class="fs-title">{p.data.title}</h3>
                  <p class="feat-meta dark">{p.data.readTime} okuma</p>
                </div>
              </a>
            ))}
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- FILTER BAR -->
  <div class="filter-bar" id="tum-rehberler">
    <div class="container filter-inner">
      <div class="chips">
        <button class="chip active" data-theme="">Tümü</button>
        {themes.map((t) => (
          <button class="chip" data-theme={t.key}><span class="dot" style={`background:${t.color}`}></span>{t.label}</button>
        ))}
      </div>
      <p class="result-count" id="result-count">{posts.length} rehber</p>
    </div>
  </div>

  <!-- GRID -->
  <section class="grid-section">
    <div class="container">
      <div class="card-grid">
        {posts.map((post, i) => (
          <a href={`/rehberler/${post.slug}`} class="card" data-theme={post.theme.key} data-search={post.search} data-featured={i < 3 ? '1' : undefined}>
            <div class="card-img">
              <img src={post.img} alt={post.data.imageAlt || post.data.title} loading="lazy" decoding="async" onerror="this.style.display='none'" />
              <span class="tag on-img" style={`background:${post.theme.color}`}>{post.theme.label}</span>
            </div>
            <div class="card-body">
              <h3 class="card-title">{post.data.title}</h3>
              <p class="card-desc">{post.data.description}</p>
              <p class="card-meta">
                <span>{shortDate(post.data.pubDate)}</span>
                <span class="sep">·</span>
                <span>{post.data.readTime} okuma</span>
                <span class="arrow">→</span>
              </p>
            </div>
          </a>
        ))}
      </div>
      <div class="empty" id="empty" hidden>
        <IzmirIcon name="harita" size={90} />
        <p>Aradığın şeyle eşleşen bir rehber bulamadık. Başka bir yer adı dene ya da <a href="https://instagram.com/izmiruzmani" target="_blank" rel="noopener">Instagram’dan bize yaz</a>, rehberini hazırlayalım.</p>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="cta-section">
    <div class="container cta-grid">
      <a href="https://instagram.com/izmiruzmani" target="_blank" rel="noopener" class="cta-card cta-ig">
        <p class="cta-eyebrow">Instagram</p>
        <h2 class="cta-title">Yeni rehberleri ilk sen gör</h2>
        <p class="cta-desc">Gizli köşeler, gezi önerileri ve şehirden kareler her gün @izmiruzmani hesabında.</p>
        <span class="cta-btn">Takip et →</span>
      </a>
      <a href="/etkinlikler" class="cta-card cta-ev">
        <span class="cta-icon"><IzmirIcon name="bilet" size={88} /></span>
        <div>
          <p class="cta-eyebrow dark">Bu hafta</p>
          <h2 class="cta-title dark">Şehirde neler var?</h2>
          <p class="cta-desc dark">Konser, tiyatro ve sergiler için etkinlik takvimine göz at.</p>
          <span class="cta-btn dark">Etkinlikler →</span>
        </div>
      </a>
    </div>
  </section>

</Layout>

<style>
  .container { max-width: 1200px; margin: 0 auto; padding: 0 20px; }
  .eyebrow { font-size: 12px; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: #062f96; margin-bottom: 14px; }
  .sec-title {
    font-family: 'Fraunces', serif; font-weight: 700; font-size: clamp(22px, 2.8vw, 30px);
    color: #1a1a1a; letter-spacing: -0.01em; margin-bottom: 22px;
  }
  .tag { display: inline-block; color: #fff; font-size: 11px; font-weight: 600; padding: 4px 10px; border-radius: 999px; }

  /* HERO */
  .hero { position: relative; overflow: hidden; background: linear-gradient(180deg, #fff9f3 0%, #f5e8d8 100%); padding: clamp(32px, 5vw, 64px) 0 clamp(36px, 5vw, 64px); }
  .blob { position: absolute; border-radius: 50%; filter: blur(64px); pointer-events: none; }
  .blob-a { top: -80px; right: -60px; width: 440px; height: 440px; background: rgba(6,47,150,0.09); animation: floatA 10s ease-in-out infinite; }
  .blob-b { bottom: -120px; left: -80px; width: 380px; height: 380px; background: rgba(255,124,17,0.10); animation: floatB 13s ease-in-out infinite; }
  .hero-grid { position: relative; display: grid; gap: 20px; align-items: center; }
  @media (min-width: 900px) { .hero-grid { grid-template-columns: 1.3fr 1fr; gap: 40px; } }
  .hero-text { animation: fadeUp 0.6s ease both; }
  .breadcrumb { font-size: 12px; color: #999; margin-bottom: 22px; }
  .bc-link { color: #062f96; }
  .hero-title { font-family: 'Fraunces', serif; font-weight: 800; color: #1a1a1a; font-size: clamp(36px, 5.6vw, 64px); line-height: 1.04; letter-spacing: -0.03em; margin-bottom: 16px; }
  .hero-sub { font-size: 16px; color: #555; line-height: 1.75; max-width: 520px; margin-bottom: 24px; }
  .search {
    display: flex; align-items: center; gap: 10px; background: #fff; border: 1.5px solid #e4d9cd; border-radius: 14px;
    padding: 0 16px; max-width: 540px; color: #062f96; box-shadow: 0 12px 30px -18px rgba(90,58,26,0.4);
    transition: border-color 0.2s;
  }
  .search:focus-within { border-color: #062f96; }
  .search input { flex: 1; border: 0; outline: 0; background: transparent; font: 500 15px 'Poppins', sans-serif; color: #1a1a1a; padding: 15px 0; min-width: 0; }
  .popular { display: flex; flex-wrap: wrap; gap: 6px; align-items: center; margin-top: 14px; max-width: 560px; }
  .pop-label { font-size: 12px; color: #999; margin-right: 2px; }
  .pop {
    font: 500 12px 'Poppins', sans-serif; color: #555; background: rgba(255,255,255,0.7); border: 1px solid #ecdccb;
    border-radius: 999px; padding: 4px 11px; cursor: pointer; transition: border-color 0.2s, color 0.2s;
  }
  .pop:hover { border-color: #062f96; color: #062f96; }

  .hero-art { position: relative; height: clamp(220px, 28vw, 330px); max-width: 440px; width: 100%; margin: 0 auto; }
  .art-disc { position: absolute; inset: 14% 6% 2%; border-radius: 50%; background: radial-gradient(circle at 40% 35%, #e3ecff 0%, #bcd0fa 60%, #9fbaf5 100%); box-shadow: inset 0 -14px 30px rgba(6,47,150,0.15); }
  :global(.art) { position: absolute; filter: drop-shadow(0 16px 16px rgba(90,58,26,0.2)); height: auto; }
  :global(.art-harita) { left: 18%; bottom: 0; width: 50%; animation: bob 6s ease-in-out infinite; }
  :global(.art-kule) { left: 4%; top: 6%; width: 34%; animation: bob 7s ease-in-out infinite 0.8s; }
  :global(.art-palm) { right: 6%; top: 14%; width: 28%; animation: bob 6.5s ease-in-out infinite 1.4s; }
  :global(.art-marti) { right: 30%; top: 0; width: 16%; animation: bob 8s ease-in-out infinite 0.4s; }
  @keyframes bob { 0%,100% { transform: translateY(0); } 50% { transform: translateY(-8px); } }
  @media (prefers-reduced-motion: reduce) { :global(.art), .blob { animation: none !important; } }
  @media (max-width: 700px) { .hero-art { display: none; } }

  /* THEMES */
  .themes { background: #fff9f3; padding: clamp(40px, 6vw, 64px) 0 clamp(24px, 4vw, 40px); }
  .theme-grid { display: grid; gap: 10px; grid-template-columns: 1fr 1fr; }
  .chips.theme-chips { display: none; }
  @media (max-width: 599px) {
    .themes { padding: 24px 0 8px; }
    .themes .sec-title { font-size: 18px; margin-bottom: 12px; }
    .theme-grid { display: none; }
    .chips.theme-chips { display: flex; }
  }
  @media (min-width: 600px) and (max-width: 1023px) { .theme-grid { gap: 12px; } }
  @media (min-width: 1024px) { .theme-grid { grid-template-columns: repeat(5, 1fr); } }
  .theme {
    font-family: 'Poppins', sans-serif; text-align: left; cursor: pointer; border: 1px solid #efe2d3; background: #fff;
    border-radius: 20px; padding: 16px; display: flex; gap: 14px; align-items: center;
    transition: transform 0.25s, box-shadow 0.25s, border-color 0.25s;
  }
  @media (min-width: 1024px) { .theme { flex-direction: column; align-items: flex-start; padding: 20px; } }
  .theme:hover { transform: translateY(-3px); border-color: var(--c); box-shadow: 0 18px 36px -22px rgba(90,58,26,0.5); }
  .theme-icon {
    flex-shrink: 0; width: 84px; height: 84px; border-radius: 22px; display: flex; align-items: center; justify-content: center;
    background: linear-gradient(145deg, #fff 0%, #f3e6d6 100%); box-shadow: inset 0 2px 0 #fff, 0 8px 20px -12px rgba(90,58,26,0.4);
  }
  .theme-text { display: flex; flex-direction: column; gap: 3px; }
  .theme-name { font-size: 16px; font-weight: 600; color: #1a1a1a; }
  .theme-desc { font-size: 13px; color: #777; line-height: 1.5; }
  .theme-count { font-size: 12px; font-weight: 600; color: var(--c); margin-top: 4px; }

  /* FEATURED */
  .featured { background: #fff9f3; padding: clamp(24px, 4vw, 40px) 0 clamp(40px, 6vw, 64px); }
  .feat-grid { display: grid; gap: 16px; }
  @media (min-width: 900px) { .feat-grid { grid-template-columns: 1.6fr 1fr; gap: 20px; } }
  .feat-lead { position: relative; border-radius: 22px; overflow: hidden; min-height: 340px; display: block; background: #ddd0c4; }
  .feat-lead img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s; }
  .feat-lead:hover img { transform: scale(1.03); }
  .feat-overlay {
    position: absolute; inset: auto 0 0 0; padding: 80px 26px 24px;
    background: linear-gradient(180deg, transparent 0%, rgba(10,14,30,0.55) 35%, rgba(10,14,30,0.88) 100%); color: #fff;
  }
  .feat-title { font-family: 'Fraunces', serif; font-weight: 700; font-size: clamp(22px, 2.6vw, 30px); line-height: 1.2; margin: 10px 0 8px; }
  .feat-desc { font-size: 14px; line-height: 1.6; opacity: 0.88; max-width: 560px; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .feat-meta { font-size: 12px; opacity: 0.75; margin-top: 10px; }
  .feat-meta.dark { color: #999; opacity: 1; margin-top: 6px; }
  .feat-lead:hover { color: #fff; }
  .feat-side { display: grid; gap: 16px; }
  .feat-small {
    display: grid; grid-template-columns: 130px 1fr; gap: 16px; align-items: center; background: #fff; border-radius: 18px;
    padding: 12px; border: 1px solid #efe2d3; transition: transform 0.25s, box-shadow 0.25s;
  }
  .feat-small:hover { transform: translateY(-3px); box-shadow: 0 18px 36px -24px rgba(90,58,26,0.5); color: inherit; }
  .fs-img { aspect-ratio: 1; border-radius: 12px; overflow: hidden; background: #ede5db; }
  .fs-img img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .fs-title { font-size: 15px; font-weight: 600; line-height: 1.4; margin-top: 8px; color: #1a1a1a; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }

  /* FILTER BAR */
  .filter-bar { position: sticky; top: 64px; z-index: 20; background: rgba(255,249,243,0.92); backdrop-filter: blur(10px); border-top: 1px solid #ede5db; border-bottom: 1px solid #ede5db; padding: 12px 0; }
  .filter-inner { display: flex; gap: 12px; align-items: center; }
  .chips { display: flex; gap: 6px; overflow-x: auto; scrollbar-width: none; flex: 1; min-width: 0; padding: 2px 0; }
  .chips::-webkit-scrollbar { display: none; }
  .chip {
    font: 500 13px 'Poppins', sans-serif; color: #555; white-space: nowrap; padding: 7px 15px; border-radius: 999px;
    border: 1.5px solid #e4d9cd; background: #fff; cursor: pointer; display: inline-flex; align-items: center; gap: 6px;
    transition: border-color 0.2s, background 0.2s, color 0.2s;
  }
  .chip:hover { border-color: #bbb; }
  .chip.active { background: #062f96; border-color: #062f96; color: #fff; }
  .dot { width: 8px; height: 8px; border-radius: 50%; }
  .result-count { font-size: 13px; color: #999; white-space: nowrap; flex-shrink: 0; }
  @media (max-width: 600px) { .result-count { display: none; } }

  /* GRID */
  .grid-section { background: #fff9f3; padding: clamp(28px, 4vw, 48px) 0 clamp(48px, 6vw, 72px); }
  .card-grid { display: grid; grid-template-columns: 1fr; gap: 20px; }
  @media (min-width: 700px) { .card-grid { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 1024px) { .card-grid { grid-template-columns: 1fr 1fr 1fr; gap: 24px; } }
  .card { background: #fff; border-radius: 20px; overflow: hidden; border: 1px solid rgba(0,0,0,0.05); display: flex; flex-direction: column; transition: transform 0.25s, box-shadow 0.25s; }
  .card[hidden] { display: none; }
  .card:hover { transform: translateY(-4px); box-shadow: 0 22px 44px -24px rgba(90,58,26,0.45); color: inherit; }
  .card-img { position: relative; aspect-ratio: 16 / 10; background: linear-gradient(135deg, #ede5db 0%, #ddd0c4 100%); overflow: hidden; }
  .card-img img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s; }
  .card:hover .card-img img { transform: scale(1.04); }
  .tag.on-img { position: absolute; top: 12px; left: 12px; box-shadow: 0 4px 10px -4px rgba(0,0,0,0.4); }
  .card-body { padding: 18px 20px 20px; display: flex; flex-direction: column; flex: 1; }
  .card-title { font-size: 16px; font-weight: 600; color: #1a1a1a; line-height: 1.4; margin-bottom: 8px; }
  .card-desc { font-size: 13.5px; color: #666; line-height: 1.65; flex: 1; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .card-meta { font-size: 12px; color: #999; margin-top: 14px; display: flex; gap: 6px; align-items: center; }
  .arrow { margin-left: auto; color: #062f96; font-size: 16px; transition: transform 0.2s; }
  .card:hover .arrow { transform: translateX(4px); }
  .empty { text-align: center; padding: 40px 0; color: #666; max-width: 520px; margin: 0 auto; line-height: 1.7; }
  .empty[hidden] { display: none; }
  .empty :global(svg) { display: block; margin: 0 auto 8px; }
  .empty a { color: #062f96; text-decoration: underline; }

  /* CTA */
  .cta-section { background: #f0e8df; padding: clamp(48px, 7vw, 80px) 0; }
  .cta-grid { display: grid; gap: 20px; }
  @media (min-width: 900px) { .cta-grid { grid-template-columns: 1.2fr 1fr; } }
  .cta-card { border-radius: 24px; padding: clamp(26px, 4vw, 40px); display: block; transition: transform 0.25s; }
  .cta-card:hover { transform: translateY(-3px); }
  .cta-ig { background: linear-gradient(135deg, #f58529 0%, #dd2a7b 45%, #8134af 75%, #515bd4 100%); color: #fff; }
  .cta-ig:hover { color: #fff; }
  .cta-ev { background: #fff9f3; border: 1px solid #e4d9cd; display: flex; gap: 18px; align-items: center; }
  .cta-icon { flex-shrink: 0; }
  @media (max-width: 500px) { .cta-ev { flex-direction: column; align-items: flex-start; } }
  .cta-eyebrow { font-size: 12px; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: rgba(255,255,255,0.8); margin-bottom: 10px; }
  .cta-title { font-family: 'Fraunces', serif; font-weight: 800; font-size: clamp(24px, 3vw, 34px); line-height: 1.15; margin-bottom: 12px; }
  .cta-desc { font-size: 15px; line-height: 1.7; opacity: 0.92; margin-bottom: 22px; max-width: 460px; }
  .cta-btn { display: inline-block; background: #fff; color: #1a1a1a; font-weight: 600; font-size: 14px; padding: 12px 22px; border-radius: 999px; }
  .dark { color: #1a1a1a; }
  .cta-eyebrow.dark { color: #062f96; }
  .cta-desc.dark { color: #666; }
  .cta-btn.dark { background: #062f96; color: #fff; }
</style>

<script>
  const q = document.getElementById('q') as HTMLInputElement | null;
  const chips = document.querySelectorAll<HTMLButtonElement>('.chip[data-theme]');
  const cards = document.querySelectorAll<HTMLElement>('.card');
  const count = document.getElementById('result-count');
  const empty = document.getElementById('empty');
  const featured = document.getElementById('featured');
  const bar = document.getElementById('tum-rehberler');
  const state = { theme: '', q: '' };

  function apply() {
    const terms = state.q.toLocaleLowerCase('tr').split(/\s+/).filter(Boolean);
    const filtering = !!(state.theme || terms.length);
    let n = 0;
    cards.forEach((c) => {
      const s = c.dataset.search ?? '';
      const match = (!state.theme || c.dataset.theme === state.theme) && terms.every((t) => s.includes(t));
      if (match) n++;
      // Unfiltered, the newest three already sit in the "Yeni eklenenler" block above.
      c.hidden = !match || (!filtering && c.dataset.featured === '1');
    });
    if (count) count.textContent = `${n} rehber`;
    if (empty) empty.hidden = n > 0;
    if (featured) featured.hidden = filtering;
  }
  const jump = () => bar?.scrollIntoView({ behavior: 'smooth', block: 'start' });
  const setTheme = (key: string) => {
    state.theme = key;
    chips.forEach((b) => b.classList.toggle('active', (b.dataset.theme ?? '') === key));
    apply();
  };

  chips.forEach((b) => b.addEventListener('click', () => { setTheme(b.dataset.theme ?? ''); if (b.dataset.jump !== undefined) jump(); }));
  document.querySelectorAll<HTMLButtonElement>('[data-theme-pick]').forEach((b) =>
    b.addEventListener('click', () => { setTheme(b.dataset.themePick ?? ''); jump(); }));
  document.querySelectorAll<HTMLButtonElement>('.pop').forEach((b) =>
    b.addEventListener('click', () => { if (q) q.value = b.dataset.q ?? ''; state.q = b.dataset.q ?? ''; apply(); jump(); }));
  q?.addEventListener('input', () => { state.q = q.value; apply(); });
  q?.addEventListener('keydown', (e) => { if (e.key === 'Enter') jump(); });

  // Links from the homepage can preselect a search (?q=) or a theme (?tema=).
  const params = new URLSearchParams(location.search);
  const initialQ = params.get('q')?.trim() ?? '';
  const initialTheme = params.get('tema') ?? '';
  if (initialQ && q) { q.value = initialQ; state.q = initialQ; }
  if (initialTheme && [...chips].some((b) => b.dataset.theme === initialTheme)) setTheme(initialTheme);
  apply();
  if (initialQ || initialTheme) requestAnimationFrame(jump);
</script>
