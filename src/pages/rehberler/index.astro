---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog');
const sorted = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

function catColor(cat: string) {
  const map: Record<string, string> = {
    'Kafeler': '#ff7c11',
    'Semtler': '#062f96',
    'Gece Hayatı': '#ff7c11',
    'Keşfet': '#062f96',
    'Etkinlikler': '#062f96',
  };
  return map[cat] ?? '#062f96';
}

function formatDate(d: Date) {
  return d.toLocaleDateString('tr-TR', { day: 'numeric', month: 'kısa', year: 'numeric' });
}

const cats = ['Tümü', ...Array.from(new Set(sorted.map(p => p.data.category)))];
---

<Layout title="Rehberler" activePage="rehberler" description="İzmir'in en iyi mekan ve deneyimleri için kapsamlı yerel rehberler.">

  <!-- PAGE HEADER -->
  <section class="page-header">
    <div class="container anim">
      <p class="breadcrumb"><a href="/" class="bc-link">Ana Sayfa</a> · Rehberler</p>
      <h1 class="page-title">Rehberler</h1>
      <p class="page-desc">İzmir'in en iyi mekan ve deneyimleri için kapsamlı yerel rehberler.</p>
    </div>
  </section>

  <!-- FILTER -->
  <div class="filter-bar">
    <div class="container">
      <div class="cat-scroll">
        {cats.map((c, i) => (
          <button class:list={['cat-btn', { active: i === 0 }]} data-cat={c}>{c}</button>
        ))}
      </div>
    </div>
  </div>

  <!-- GRID -->
  <section class="grid-section">
    <div class="container">
      <div class="card-grid" id="card-grid">
        {sorted.map(post => (
          <article class="guide-card" data-cat={post.data.category}>
            <a href={`/rehberler/${post.slug}`}>
              <div class="card-img">
                <img
                  src={post.data.image ?? `/images/blog/${post.slug}.webp`}
                  alt={post.data.imageAlt || post.data.title}
                  class="card-img-photo"
                  onerror="this.style.display='none'"
                  loading="lazy"
                  decoding="async"
                />
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#bfb3a8" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/><circle cx="12" cy="13" r="4"/></svg>
              </div>
              <div class="card-body">
                <span class="cat-badge" style={`background:${catColor(post.data.category)}`}>{post.data.category}</span>
                <h3 class="card-title">{post.data.title}</h3>
                <p class="card-desc">{post.data.description}</p>
                <p class="card-meta">{post.data.pubDate.toLocaleDateString('tr-TR', { day: 'numeric', month: 'short', year: 'numeric' })} · {post.data.readTime} okuma</p>
              </div>
            </a>
          </article>
        ))}
      </div>
      {sorted.length === 0 && (
        <p class="empty-msg">Henüz içerik yok. Yakında burada olacak!</p>
      )}
    </div>
  </section>

</Layout>

<style>
  .container { max-width: 1200px; margin: 0 auto; padding: 0 20px; }

  .page-header { background: #f0e8df; padding: 48px 20px; }
  .anim { animation: fadeUp 0.5s ease both; }
  .breadcrumb { font-size: 12px; color: #999; margin-bottom: 10px; }
  .bc-link { color: #062f96; transition: opacity 0.15s; }
  .bc-link:hover { opacity: 0.7; color: #062f96; }
  .page-title { font-size: clamp(28px,4vw,40px); font-weight: 600; color: #1a1a1a; margin-bottom: 8px; }
  .page-desc { font-size: 15px; color: #666; }

  .filter-bar { background: #fff9f3; padding: 16px 20px; border-bottom: 1px solid #ede5db; }
  .cat-scroll {
    display: flex; gap: 8px; overflow-x: auto;
    padding-bottom: 2px; scrollbar-width: none; -ms-overflow-style: none;
  }
  .cat-scroll::-webkit-scrollbar { display: none; }
  .cat-btn {
    font-family: 'Poppins', sans-serif; font-size: 13px; font-weight: 500;
    padding: 8px 18px; border-radius: 20px; cursor: pointer; white-space: nowrap;
    background: #fff; color: #555; border: 1.5px solid #e0d8d0;
    transition: background 0.2s, color 0.2s;
  }
  .cat-btn.active { background: #062f96; color: #fff; border-color: #062f96; }
  .cat-btn:hover:not(.active) { border-color: #999; }

  .grid-section { background: #fff9f3; padding: clamp(40px,5vw,64px) 20px; }
  .card-grid { display: grid; grid-template-columns: 1fr; gap: 20px; }
  @media (min-width: 700px) { .card-grid { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 1024px) { .card-grid { grid-template-columns: 1fr 1fr 1fr; } }

  .guide-card {
    background: #fff; border-radius: 14px; overflow: hidden;
    border: 1px solid rgba(0,0,0,0.06);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .guide-card:hover { transform: translateY(-3px); box-shadow: 0 8px 28px rgba(0,0,0,0.08); }
  .guide-card a { display: block; color: inherit; }
  .card-img {
    background: linear-gradient(135deg,#ede5db 0%,#ddd0c4 100%);
    aspect-ratio: 4/3; display: flex; align-items: center; justify-content: center;
    overflow: hidden; position: relative;
  }
  .card-img-photo {
    position: absolute; inset: 0;
    width: 100%; height: 100%; object-fit: cover;
  }
  .card-body { padding: 20px; }
  .cat-badge {
    display: inline-block; font-size: 11px; font-weight: 600;
    padding: 4px 12px; border-radius: 20px; letter-spacing: 0.03em;
    color: #fff; margin-bottom: 12px;
  }
  .card-title { font-size: 15px; font-weight: 600; color: #1a1a1a; line-height: 1.45; margin-bottom: 8px; }
  .card-desc { font-size: 13px; color: #666; line-height: 1.6; margin-bottom: 16px; }
  .card-meta { font-size: 12px; color: #999; }
  .empty-msg { font-size: 15px; color: #999; text-align: center; padding: 48px 0; }
</style>

<script>
  const btns = document.querySelectorAll('.cat-btn');
  const cards = document.querySelectorAll('.guide-card');
  btns.forEach(btn => {
    btn.addEventListener('click', () => {
      btns.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      const cat = btn.getAttribute('data-cat');
      cards.forEach(card => {
        const c = card.getAttribute('data-cat');
        (card as HTMLElement).style.display = (cat === 'Tümü' || cat === c) ? '' : 'none';
      });
    });
  });
</script>
