---
import Layout from '../layouts/Layout.astro';
import IzmirIcon from '../components/IzmirIcon.astro';
import IzmirScene from '../components/IzmirScene.astro';
import { getCollection } from 'astro:content';
import siteConfig from '../data/site-config.json';
import { getEvents, weekday, time, fmt, catColor as eventColor } from '../lib/events';
import { THEMES, themeOf, postImage, shortDate } from '../lib/themes';

const hero = siteConfig.hero;

const allPosts = await getCollection('blog');
const sorted = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const istanbulDay = (d: Date) => new Intl.DateTimeFormat('en-CA', { timeZone: 'Europe/Istanbul' }).format(d);
const today = istanbulDay(new Date());
const featuredPost = sorted.find(p => istanbulDay(p.data.pubDate) < today) ?? sorted[0];
const sidePosts = sorted.filter(p => p.slug !== featuredPost?.slug).slice(0, 4);
const shown = new Set([featuredPost?.slug, ...sidePosts.map(p => p.slug)]);
const gridPosts = sorted.filter(p => !shown.has(p.slug)).slice(0, 6);

const counts = Object.fromEntries(THEMES.map(t => [t.key, sorted.filter(p => themeOf(p.data.category).key === t.key).length]));
const themes = THEMES.filter(t => counts[t.key] > 0 && t.key !== 'ulasim');

const allEvents = await getEvents();
const events = [...allEvents.filter(e => !e.ongoing), ...allEvents.filter(e => e.ongoing)].slice(0, 4);
const dayNum = (d: string) => fmt(d, { day: 'numeric' });
const monthShort = (d: string) => fmt(d, { month: 'short' });

const transit = [
  { label: 'Metro', href: '/toplu-tasima-saatleri/metro' },
  { label: 'İZBAN', href: '/toplu-tasima-saatleri/izban' },
  { label: 'Vapur', href: '/toplu-tasima-saatleri/vapur' },
  { label: 'Otobüs', href: '/toplu-tasima-saatleri/otobus' },
  { label: 'Tramvay', href: '/toplu-tasima-saatleri/tramvay' },
];

const igPosts = Array.from({ length: 10 }, (_, i) => `/images/instagram/${i + 1}.webp?v=2`);
---

<Layout title="İzmir Rehberi, Etkinlikler ve Ulaşım" description="İzmir'i yerel gözüyle keşfet: gezilecek yerler, semtler, tarihi mekanlar, güncel etkinlikler ve toplu taşıma saatleri tek yerde.">

  <!-- HERO -->
  <section class="hero">
    <div class="blob blob-a"></div>
    <div class="blob blob-b"></div>
    <div class="container hero-grid">
      <div class="hero-text">
        <p class="eyebrow">{hero.eyebrow}</p>
        <h1 class="hero-title" set:html={hero.title.replace(/\n/g, '<br/>')} />
        <p class="hero-sub">{hero.subtitle}</p>
        <form class="search" action="/rehberler" method="get" role="search">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
          <input name="q" type="search" placeholder="Nereyi keşfetmek istersin?" autocomplete="off" aria-label="Rehberlerde ara" />
          <button type="submit">Ara</button>
        </form>
        <div class="hero-cta">
          <a href="/rehberler" class="link-pill">{hero.ctaPrimary} →</a>
          <a href="/etkinlikler" class="link-pill">{hero.ctaSecondary} →</a>
        </div>
      </div>
      <div class="hero-art"><IzmirScene /></div>
    </div>
  </section>

  <!-- TRANSIT QUICK LINKS -->
  <nav class="quick" aria-label="Toplu taşıma saatleri">
    <div class="container quick-inner">
      <span class="quick-label">
        <IzmirIcon name="vapur" size={28} />
        Sefer saatleri
      </span>
      <div class="quick-links">
        {transit.map(t => <a href={t.href} class="quick-link">{t.label}</a>)}
      </div>
    </div>
  </nav>

  <!-- FEATURED -->
  {featuredPost && (
    <section class="featured">
      <div class="container">
        <div class="sec-head">
          <h2 class="sec-title">Öne çıkanlar</h2>
          <a href="/rehberler" class="see-all">Tüm rehberler →</a>
        </div>
        <div class="feat-grid">
          <a href={`/rehberler/${featuredPost.slug}`} class="feat-lead">
            <img src={postImage(featuredPost)} alt={featuredPost.data.imageAlt || featuredPost.data.title} loading="eager" fetchpriority="high" decoding="async" />
            <div class="feat-overlay">
              <span class="tag" style={`background:${themeOf(featuredPost.data.category).color}`}>{themeOf(featuredPost.data.category).label}</span>
              <h3 class="feat-title">{featuredPost.data.title}</h3>
              <p class="feat-desc">{featuredPost.data.description}</p>
              <p class="feat-meta">{shortDate(featuredPost.data.pubDate)} · {featuredPost.data.readTime} okuma</p>
            </div>
          </a>
          <div class="feat-side">
            {sidePosts.map(p => (
              <a href={`/rehberler/${p.slug}`} class="feat-small">
                <div class="fs-img"><img src={postImage(p)} alt={p.data.imageAlt || p.data.title} loading="lazy" decoding="async" /></div>
                <div>
                  <span class="tag sm" style={`background:${themeOf(p.data.category).color}`}>{themeOf(p.data.category).label}</span>
                  <h3 class="fs-title">{p.data.title}</h3>
                </div>
              </a>
            ))}
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- THEMES -->
  <section class="themes">
    <div class="container">
      <h2 class="sec-title">Ne keşfetmek istersin?</h2>
      <div class="theme-chips">
        {themes.map(t => (
          <a href={`/rehberler?tema=${t.key}#tum-rehberler`} class="chip"><span class="dot" style={`background:${t.color}`}></span>{t.label}</a>
        ))}
      </div>
      <div class="theme-grid">
        {themes.map(t => (
          <a href={`/rehberler?tema=${t.key}#tum-rehberler`} class="theme" style={`--c:${t.color}`}>
            <span class="theme-icon"><IzmirIcon name={t.icon} size={72} /></span>
            <span class="theme-name">{t.label}</span>
            <span class="theme-desc">{t.desc}</span>
            <span class="theme-count">{counts[t.key]} rehber →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- EVENTS -->
  {events.length > 0 && (
    <section class="events" id="etkinlikler">
      <div class="container">
        <div class="sec-head">
          <h2 class="sec-title">Bu hafta İzmir’de</h2>
          <a href="/etkinlikler" class="see-all">Tüm etkinlikler →</a>
        </div>
        <div class="ev-grid">
          {events.map(ev => {
            const free = ev.admission === 'free' || ev.admission === 'free-ticket';
            return (
              <a href={`/etkinlikler/${ev.slug}`} class="ev-card">
                <div class="ev-img">
                  {ev.image ? <img src={ev.image} alt={ev.title} loading="lazy" decoding="async" /> : <div class="img-ph"><IzmirIcon name="bilet" size={70} /></div>}
                  <div class="date-chip">
                    {ev.ongoing ? (
                      <><span class="dc-small green">son gün</span><span class="dc-day">{dayNum(ev.next.end)}</span><span class="dc-month">{monthShort(ev.next.end)}</span></>
                    ) : (
                      <><span class="dc-small">{weekday(ev.next.start)}</span><span class="dc-day">{dayNum(ev.next.start)}</span><span class="dc-month">{monthShort(ev.next.start)}</span></>
                    )}
                  </div>
                  <span class="cat-tag" style={`background:${eventColor(ev.category)}`}>{ev.category.trim()}</span>
                  {free && <span class="free-tag">Ücretsiz</span>}
                </div>
                <div class="ev-body">
                  <h3 class="ev-title">{ev.title}</h3>
                  <p class="ev-meta">{ev.next.venue ?? 'İzmir'}{!ev.ongoing && ` · ${time(ev.next.start)}`}</p>
                </div>
              </a>
            );
          })}
        </div>
      </div>
    </section>
  )}

  <!-- LATEST GRID -->
  {gridPosts.length > 0 && (
    <section class="latest">
      <div class="container">
        <div class="sec-head">
          <h2 class="sec-title">Son rehberler</h2>
          <a href="/rehberler" class="see-all">Tümünü gör →</a>
        </div>
        <div class="card-grid">
          {gridPosts.map(post => {
            const t = themeOf(post.data.category);
            return (
              <a href={`/rehberler/${post.slug}`} class="card">
                <div class="card-img">
                  <img src={postImage(post)} alt={post.data.imageAlt || post.data.title} loading="lazy" decoding="async" onerror="this.style.display='none'" />
                  <span class="tag on-img" style={`background:${t.color}`}>{t.label}</span>
                </div>
                <div class="card-body">
                  <h3 class="card-title">{post.data.title}</h3>
                  <p class="card-desc">{post.data.description}</p>
                  <p class="card-meta">{shortDate(post.data.pubDate)} · {post.data.readTime} okuma <span class="arrow">→</span></p>
                </div>
              </a>
            );
          })}
        </div>
      </div>
    </section>
  )}

  <!-- INSTAGRAM -->
  <section class="ig">
    <div class="container">
      <div class="ig-card">
        <div class="ig-head">
          <div>
            <p class="ig-eyebrow">Instagram</p>
            <h2 class="ig-title">İzmir’in güncel hali, her gün akışında.</h2>
          </div>
          <a href="https://instagram.com/izmiruzmani" target="_blank" rel="noopener" class="ig-btn">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1.5" fill="currentColor" stroke="none"/></svg>
            @izmiruzmani
          </a>
        </div>
        <div class="ig-grid">
          {igPosts.map(src => (
            <a href="https://www.instagram.com/izmiruzmani/" target="_blank" rel="noopener" class="ig-cell">
              <img src={src} alt="İzmir Uzmanı Instagram gönderisi" loading="lazy" decoding="async" />
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ABOUT TEASER -->
  <section class="about">
    <div class="container about-inner">
      <IzmirIcon name="saatkulesi" size={110} />
      <div>
        <h2 class="sec-title">İzmir’i yerel gözüyle anlatıyoruz.</h2>
        <p class="about-text">İzmir Uzmanı; şehrin gezilecek yerlerini, semtlerini, etkinliklerini ve gündelik hayatını sade ve samimi bir dille anlatan bağımsız bir şehir rehberi.</p>
        <a href="/hakkinda" class="see-all">Hikayemizi oku →</a>
      </div>
    </div>
  </section>

</Layout>

<style>
  .container { max-width: 1200px; margin: 0 auto; padding: 0 20px; }
  .eyebrow { font-size: 12px; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: #062f96; margin-bottom: 16px; }
  .sec-head { display: flex; align-items: baseline; justify-content: space-between; gap: 16px; margin-bottom: 22px; }
  .sec-title { font-family: 'Fraunces', serif; font-weight: 700; font-size: clamp(24px, 3vw, 32px); color: #1a1a1a; letter-spacing: -0.01em; line-height: 1.2; }
  .themes .sec-title { margin-bottom: 22px; }
  .see-all { font-size: 14px; font-weight: 600; color: #062f96; white-space: nowrap; }
  .see-all:hover { color: #041e6e; }
  .tag { display: inline-block; color: #fff; font-size: 11px; font-weight: 600; padding: 4px 11px; border-radius: 999px; }
  .tag.sm { font-size: 10px; padding: 3px 9px; }

  /* HERO */
  .hero { position: relative; overflow: hidden; background: linear-gradient(180deg, #fff9f3 0%, #f5e8d8 100%); padding: clamp(36px, 6vw, 80px) 0 clamp(36px, 5vw, 64px); }
  .blob { position: absolute; border-radius: 50%; filter: blur(64px); pointer-events: none; }
  .blob-a { top: -80px; right: -80px; width: 460px; height: 460px; background: rgba(255,124,17,0.12); animation: floatA 10s ease-in-out infinite; }
  .blob-b { bottom: -120px; left: -80px; width: 420px; height: 420px; background: rgba(6,47,150,0.08); animation: floatB 13s ease-in-out infinite; }
  .hero-grid { position: relative; display: grid; grid-template-columns: minmax(0, 1fr); gap: 24px; align-items: center; }
  .hero-grid > * { min-width: 0; }
  @media (min-width: 900px) { .hero-grid { grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); gap: 40px; } }
  .hero-text { animation: fadeUp 0.6s ease both; }
  .hero-title { font-family: 'Fraunces', serif; font-weight: 800; color: #1a1a1a; font-size: clamp(42px, 6.6vw, 80px); line-height: 1.02; letter-spacing: -0.03em; margin-bottom: 20px; }
  .hero-sub { font-size: 17px; color: #555; line-height: 1.75; max-width: 500px; margin-bottom: 26px; }
  .search {
    display: flex; align-items: center; gap: 10px; background: #fff; border: 1.5px solid #e4d9cd; border-radius: 16px;
    padding: 6px 6px 6px 16px; max-width: 520px; color: #062f96; box-shadow: 0 14px 34px -20px rgba(90,58,26,0.45);
  }
  .search:focus-within { border-color: #062f96; }
  .search input { flex: 1; min-width: 0; border: 0; outline: 0; background: transparent; font: 500 15px 'Poppins', sans-serif; color: #1a1a1a; padding: 10px 0; }
  .search button { font: 600 14px 'Poppins', sans-serif; background: #062f96; color: #fff; border: 0; border-radius: 11px; padding: 11px 20px; cursor: pointer; }
  .search button:hover { background: #041e6e; }
  .hero-cta { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 18px; }
  .link-pill { font-size: 14px; font-weight: 500; color: #1a1a1a; padding: 9px 16px; border-radius: 999px; background: rgba(255,255,255,0.7); border: 1px solid #ecdccb; }
  .link-pill:hover { border-color: #062f96; color: #062f96; }
  @media (max-width: 700px) { .hero-art { max-width: 340px; margin: 0 auto; width: 100%; } }

  /* QUICK */
  .quick { background: #062f96; color: #fff; }
  .quick-inner { display: flex; align-items: center; gap: 16px; padding-top: 12px; padding-bottom: 12px; }
  .quick-label { display: inline-flex; align-items: center; gap: 8px; font-size: 13px; font-weight: 600; white-space: nowrap; }
  .quick-label :global(svg) { background: #fff; border-radius: 8px; padding: 2px; }
  .quick-links { display: flex; gap: 6px; overflow-x: auto; scrollbar-width: none; }
  .quick-links::-webkit-scrollbar { display: none; }
  .quick-link { font-size: 13px; font-weight: 500; color: #fff; padding: 6px 14px; border-radius: 999px; border: 1px solid rgba(255,255,255,0.3); white-space: nowrap; transition: background 0.2s; }
  .quick-link:hover { background: rgba(255,255,255,0.15); color: #fff; }

  /* FEATURED */
  .featured { background: #fff9f3; padding: clamp(40px, 6vw, 72px) 0 clamp(24px, 4vw, 40px); }
  .feat-grid { display: grid; gap: 16px; }
  @media (min-width: 900px) { .feat-grid { grid-template-columns: 1.5fr 1fr; gap: 20px; } }
  .feat-lead { position: relative; border-radius: 24px; overflow: hidden; min-height: 380px; display: block; background: #ddd0c4; }
  .feat-lead img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s; }
  .feat-lead:hover img { transform: scale(1.03); }
  .feat-lead:hover { color: #fff; }
  .feat-overlay { position: absolute; inset: auto 0 0 0; padding: 90px 26px 24px; color: #fff; background: linear-gradient(180deg, transparent 0%, rgba(10,14,30,0.55) 35%, rgba(10,14,30,0.88) 100%); }
  .feat-title { font-family: 'Fraunces', serif; font-weight: 700; font-size: clamp(22px, 2.8vw, 32px); line-height: 1.2; margin: 10px 0 8px; }
  .feat-desc { font-size: 14px; line-height: 1.6; opacity: 0.88; max-width: 560px; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .feat-meta { font-size: 12px; opacity: 0.75; margin-top: 10px; }
  .feat-side { display: grid; gap: 12px; }
  .feat-small { display: grid; grid-template-columns: 96px 1fr; gap: 14px; align-items: center; background: #fff; border-radius: 16px; padding: 10px; border: 1px solid #efe2d3; transition: transform 0.25s, box-shadow 0.25s; }
  .feat-small:hover { transform: translateY(-2px); box-shadow: 0 16px 32px -22px rgba(90,58,26,0.5); color: inherit; }
  .fs-img { aspect-ratio: 1; border-radius: 12px; overflow: hidden; background: #ede5db; }
  .fs-img img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .fs-title { font-size: 14.5px; font-weight: 600; line-height: 1.4; margin-top: 6px; color: #1a1a1a; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }

  /* THEMES */
  .themes { background: #fff9f3; padding: clamp(24px, 4vw, 40px) 0 clamp(48px, 6vw, 72px); }
  .theme-grid { display: grid; gap: 12px; grid-template-columns: 1fr 1fr; }
  @media (min-width: 900px) { .theme-grid { grid-template-columns: repeat(4, 1fr); gap: 16px; } }
  .theme { background: #fff; border: 1px solid #efe2d3; border-radius: 20px; padding: 18px; display: flex; flex-direction: column; gap: 4px; transition: transform 0.25s, box-shadow 0.25s, border-color 0.25s; }
  .theme:hover { transform: translateY(-3px); border-color: var(--c); box-shadow: 0 18px 36px -22px rgba(90,58,26,0.5); color: inherit; }
  .theme-icon { width: 84px; height: 84px; border-radius: 22px; display: flex; align-items: center; justify-content: center; margin-bottom: 10px; background: linear-gradient(145deg, #fff 0%, #f3e6d6 100%); box-shadow: inset 0 2px 0 #fff, 0 8px 20px -12px rgba(90,58,26,0.4); }
  .theme-name { font-size: 16px; font-weight: 600; color: #1a1a1a; }
  .theme-desc { font-size: 13px; color: #777; line-height: 1.5; }
  .theme-count { font-size: 12px; font-weight: 600; color: var(--c); margin-top: 6px; }
  .theme-chips { display: none; gap: 6px; overflow-x: auto; scrollbar-width: none; padding: 2px 0; }
  .theme-chips::-webkit-scrollbar { display: none; }
  .chip { font-size: 13px; font-weight: 500; color: #555; white-space: nowrap; padding: 7px 15px; border-radius: 999px; border: 1.5px solid #e4d9cd; background: #fff; display: inline-flex; align-items: center; gap: 6px; }
  .dot { width: 8px; height: 8px; border-radius: 50%; }
  @media (max-width: 600px) {
    .themes { padding: 8px 0 40px; }
    .themes .sec-title { font-size: 20px; margin-bottom: 12px; }
    .theme-grid { display: none; }
    .theme-chips { display: flex; }
  }

  /* EVENTS */
  .events { background: #f0e8df; padding: clamp(48px, 6vw, 72px) 0; }
  .ev-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 14px; }
  @media (min-width: 900px) { .ev-grid { grid-template-columns: repeat(4, 1fr); gap: 20px; } }
  .ev-card { background: #fff; border-radius: 18px; overflow: hidden; border: 1px solid rgba(0,0,0,0.05); display: flex; flex-direction: column; transition: transform 0.25s, box-shadow 0.25s; }
  .ev-card:hover { transform: translateY(-4px); box-shadow: 0 20px 40px -22px rgba(90,58,26,0.45); color: inherit; }
  .ev-img { position: relative; aspect-ratio: 4 / 5; background: #efe4d8; overflow: hidden; }
  .ev-img img { width: 100%; height: 100%; object-fit: cover; object-position: top; display: block; }
  .img-ph { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; }
  .date-chip { position: absolute; top: 10px; left: 10px; background: #fff; border-radius: 12px; padding: 6px 10px 7px; min-width: 52px; line-height: 1.05; box-shadow: 0 6px 16px -6px rgba(0,0,0,0.35); display: flex; flex-direction: column; align-items: center; }
  .dc-small { font-size: 10px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.06em; color: #ff7c11; }
  .dc-small.green { color: #0b7a5c; }
  .dc-day { font-family: 'Fraunces', serif; font-size: 22px; font-weight: 800; color: #1a1a1a; }
  .dc-month { font-size: 11px; font-weight: 500; color: #666; text-transform: uppercase; }
  .cat-tag { position: absolute; top: 12px; right: 10px; color: #fff; font-size: 11px; font-weight: 600; padding: 4px 10px; border-radius: 999px; }
  .free-tag { position: absolute; bottom: 10px; left: 10px; background: #0b7a5c; color: #fff; font-size: 11px; font-weight: 600; padding: 4px 10px; border-radius: 999px; }
  .ev-body { padding: 12px 14px 14px; }
  .ev-title { font-size: 14.5px; font-weight: 600; line-height: 1.35; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; margin-bottom: 4px; }
  .ev-meta { font-size: 12px; color: #888; line-height: 1.4; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }

  /* LATEST */
  .latest { background: #fff9f3; padding: clamp(48px, 6vw, 72px) 0; }
  .card-grid { display: grid; grid-template-columns: 1fr; gap: 20px; }
  @media (min-width: 700px) { .card-grid { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 1024px) { .card-grid { grid-template-columns: 1fr 1fr 1fr; gap: 24px; } }
  .card { background: #fff; border-radius: 20px; overflow: hidden; border: 1px solid rgba(0,0,0,0.05); display: flex; flex-direction: column; transition: transform 0.25s, box-shadow 0.25s; }
  .card:hover { transform: translateY(-4px); box-shadow: 0 22px 44px -24px rgba(90,58,26,0.45); color: inherit; }
  .card-img { position: relative; aspect-ratio: 16 / 10; background: linear-gradient(135deg, #ede5db 0%, #ddd0c4 100%); overflow: hidden; }
  .card-img img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s; }
  .card:hover .card-img img { transform: scale(1.04); }
  .tag.on-img { position: absolute; top: 12px; left: 12px; }
  .card-body { padding: 18px 20px 20px; display: flex; flex-direction: column; flex: 1; }
