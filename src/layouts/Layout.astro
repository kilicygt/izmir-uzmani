---
import Nav from '../components/Nav.astro';
import WeatherStrip from '../components/WeatherStrip.astro';
import Footer from '../components/Footer.astro';
import CookieBanner from '../components/CookieBanner.astro';

interface Props {
  title: string;
  description?: string;
  activePage?: 'rehberler' | 'etkinlikler' | 'ulasim' | 'hakkinda';
}

const {
  title,
  description = "İzmir'i yerel gözüyle keşfet — kafeler, etkinlikler, semtler ve daha fazlası.",
  activePage,
} = Astro.props;

const canonical = new URL(Astro.url.pathname.replace(/\/?$/, '/'), Astro.site);
const isHome = Astro.url.pathname === '/' || Astro.url.pathname === '';
const fullTitle = isHome ? `İzmir Uzmanı — ${title}` : `${title} — İzmir Uzmanı`;
// Google uses the WebSite structured data on the homepage to pick the site name in search results.
const websiteJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'İzmir Uzmanı',
  alternateName: ['Izmir Uzmani', 'izmiruzmani.com'],
  url: 'https://www.izmiruzmani.com/',
};
---

<!doctype html>
<html lang="tr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="generator" content={Astro.generator} />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:site_name" content="İzmir Uzmanı" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={isHome ? 'website' : 'article'} />
    <meta property="og:locale" content="tr_TR" />
    {isHome && (
      <script type="application/ld+json" set:html={JSON.stringify(websiteJsonLd)} />
    )}
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      var cerezTercihi = null;
      try { cerezTercihi = localStorage.getItem('cerez-tercihi'); } catch (e) {}
      gtag('consent', 'default', {
        analytics_storage: cerezTercihi === 'granted' ? 'granted' : 'denied',
        ad_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied'
      });
      gtag('js', new Date());
      gtag('config', 'G-V658W9RC55');
      // Nothing is sent to Google until the visitor accepts analytics cookies.
      window.loadGA = function () {
        if (window.gaLoaded) return;
        window.gaLoaded = true;
        var s = document.createElement('script');
        s.async = true;
        s.src = 'https://www.googletagmanager.com/gtag/js?id=G-V658W9RC55';
        document.head.appendChild(s);
      };
      if (cerezTercihi === 'granted') window.loadGA();
    </script>
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,700;9..144,800&family=Poppins:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <style is:global>
      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
      body {
        background: #fff9f3;
        color: #1a1a1a;
        font-family: 'Poppins', sans-serif;
        font-size: 16px;
        line-height: 1.6;
        overflow-x: hidden;
      }
      a { color: inherit; text-decoration: none; }
      a:hover { color: #062f96; }
      @keyframes fadeUp {
        from { opacity: 0; transform: translateY(20px); }
        to   { opacity: 1; transform: translateY(0); }
      }
      @keyframes heroGrad {
        0%, 100% { background-position: 0% 50%; }
        50%       { background-position: 100% 50%; }
      }
      @keyframes floatA {
        0%, 100% { transform: translate(0, 0); }
        50%       { transform: translate(-16px, -20px); }
      }
      @keyframes floatB {
        0%, 100% { transform: translate(0, 0); }
        50%       { transform: translate(14px, 16px); }
      }
      .cat-badge {
        display: inline-block;
        font-size: 11px;
        font-weight: 600;
        padding: 4px 12px;
        border-radius: 20px;
        letter-spacing: 0.03em;
        color: #fff;
      }
    </style>
  </head>
  <body>
    <Nav activePage={activePage} />
    <WeatherStrip />
    <slot />
    <Footer />
    <CookieBanner />
  </body>
</html>
