---
import Nav from '../components/Nav.astro';
import WeatherStrip from '../components/WeatherStrip.astro';
import Footer from '../components/Footer.astro';
import CookieBanner from '../components/CookieBanner.astro';

interface Props {
  title: string;
  description?: string;
  activePage?: 'rehberler' | 'etkinlikler' | 'ulasim' | 'hakkinda' | 'bulten';
  /** Share image (site-relative or absolute); defaults to the brand card. */
  image?: string;
  imageAlt?: string;
  /** ISO date for articles, used by link previews. */
  published?: string;
  modified?: string;
}

const {
  title,
  description = "İzmir'i yerel gözüyle keşfet — kafeler, etkinlikler, semtler ve daha fazlası.",
  activePage,
  image,
  imageAlt,
  published,
  modified,
} = Astro.props;
const ogImage = new URL((image ?? '/images/og-default.jpg').replace(/\?.*$/, ''), Astro.site).href;

const canonical = new URL(Astro.url.pathname.replace(/\/?$/, '/'), Astro.site);
const isHome = Astro.url.pathname === '/' || Astro.url.pathname === '';
// Search results cut titles at roughly 60 characters, so drop the brand suffix when it would push past that.
const suffixed = `${title} — İzmir Uzmanı`;
const fullTitle = isHome ? `İzmir Uzmanı — ${title}` : suffixed.length <= 60 ? suffixed : title;
// Google uses the WebSite structured data on the homepage to pick the site name in search results.
const websiteJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'İzmir Uzmanı',
  alternateName: ['Izmir Uzmani', 'izmiruzmani.com'],
  url: 'https://www.izmiruzmani.com/',
};
---

<!doctype html>
<html lang="tr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="generator" content={Astro.generator} />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:site_name" content="İzmir Uzmanı" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={isHome ? 'website' : 'article'} />
    <meta property="og:locale" content="tr_TR" />
    <meta property="og:image" content={ogImage} />
    {!image && <meta property="og:image:width" content="1200" />}
    {!image && <meta property="og:image:height" content="630" />}
    <meta property="og:image:alt" content={imageAlt ?? title} />
    {published && <meta property="article:published_time" content={published} />}
    {modified && <meta property="article:modified_time" content={modified} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {isHome && (
      <script type="application/ld+json" set:html={JSON.stringify(websiteJsonLd)} />
    )}
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      var cerezTercihi = null;
      try { cerezTercihi = localStorage.getItem('cerez-tercihi'); } catch (e) {}
      gtag('consent', 'default', {
        analytics_storage: cerezTercihi === 'granted' ? 'granted' : 'denied',
        ad_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied'
      });
      gtag('js', new Date());
      gtag('config', 'G-V658W9RC55');
      // Nothing is sent to Google until the visitor accepts analytics cookies.
      window.loadGA = function () {
        if (window.gaLoaded) return;
        window.gaLoaded = true;
        var s = document.createElement('script');
        s.async = true;
        s.src = 'https://www.googletagmanager.com/gtag/js?id=G-V658W9RC55';
        document.head.appendChild(s);
      };
      if (cerezTercihi === 'granted') window.loadGA();
    </script>
    <!-- Fonts are self-hosted: no third-party request blocks rendering. -->
    <link rel="preload" href="/fonts/poppins-400-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/poppins-400-latin-ext.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/fraunces-var-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/fraunces-var-latin-ext.woff2" as="font" type="font/woff2" crossorigin />
    <style is:global>
      @font-face { font-family: 'Fraunces'; font-style: normal; font-weight: 700 800; font-display: swap; src: url('/fonts/fraunces-var-latin-ext.woff2') format('woff2'); unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C4, U+2113, U+2C60-2C7F, U+A720-A7FF; }
      @font-face { font-family: 'Fraunces'; font-style: normal; font-weight: 700 800; font-display: swap; src: url('/fonts/fraunces-var-latin.woff2') format('woff2'); unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD; }
      @font-face { font-family: 'Poppins'; font-style: normal; font-weight: 400; font-display: swap; src: url('/fonts/poppins-400-latin-ext.woff2') format('woff2'); unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C4, U+2113, U+2C60-2C7F, U+A720-A7FF; }
      @font-face { font-family: 'Poppins'; font-style: normal; font-weight: 400; font-display: swap; src: url('/fonts/poppins-400-latin.woff2') format('woff2'); unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD; }
      @font-face { font-family: 'Poppins'; font-style: normal; font-weight: 500; font-display: swap; src: url('/fonts/poppins-500-latin-ext.woff2') format('woff2'); unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C4, U+2113, U+2C60-2C7F, U+A720-A7FF; }
      @font-face { font-family: 'Poppins'; font-style: normal; font-weight: 500; font-display: swap; src: url('/fonts/poppins-500-latin.woff2') format('woff2'); unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD; }
      @font-face { font-family: 'Poppins'; font-style: normal; font-weight: 600; font-display: swap; src: url('/fonts/poppins-600-latin-ext.woff2') format('woff2'); unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C4, U+2113, U+2C60-2C7F, U+A720-A7FF; }
      @font-face { font-family: 'Poppins'; font-style: normal; font-weight: 600; font-display: swap; src: url('/fonts/poppins-600-latin.woff2') format('woff2'); unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD; }
      /* Local fonts resized to the web fonts' metrics, so text does not reflow when the web fonts arrive.
         Values measured with fontTools against Arial/Times New Roman metrics on Turkish sample text. */
      @font-face { font-family: 'Poppins Fallback'; src: local('Arial'), local('ArialMT'), local('Liberation Sans'), local('Helvetica'); size-adjust: 109.7%; ascent-override: 95.72%; descent-override: 31.91%; line-gap-override: 9.12%; }
      @font-face { font-family: 'Fraunces Fallback'; src: local('Times New Roman'), local('TimesNewRomanPS-BoldMT'), local('Liberation Serif'), local('Times'); size-adjust: 105.89%; ascent-override: 92.36%; descent-override: 24.08%; line-gap-override: 0%; }
    </style>
    <style is:global>
      :root { --nav-h: 64px; }
      @media (min-width: 768px) { :root { --nav-h: 78px; } }
      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
      body {
        background: #fff9f3;
        color: #1a1a1a;
        font-family: 'Poppins', 'Poppins Fallback', sans-serif;
        font-size: 16px;
        line-height: 1.6;
        overflow-x: hidden;
      }
      a { color: inherit; text-decoration: none; }
      a:hover { color: #062f96; }
      @keyframes fadeUp {
        from { opacity: 0; transform: translateY(20px); }
        to   { opacity: 1; transform: translateY(0); }
      }
      @keyframes heroGrad {
        0%, 100% { background-position: 0% 50%; }
        50%       { background-position: 100% 50%; }
      }
      @keyframes floatA {
        0%, 100% { transform: translate(0, 0); }
        50%       { transform: translate(-16px, -20px); }
      }
      @keyframes floatB {
        0%, 100% { transform: translate(0, 0); }
        50%       { transform: translate(14px, 16px); }
      }
      .cat-badge {
        display: inline-block;
        font-size: 11px;
        font-weight: 600;
        padding: 4px 12px;
        border-radius: 20px;
        letter-spacing: 0.03em;
        color: #fff;
      }
    </style>
  </head>
  <body>
    <Nav activePage={activePage} />
    <WeatherStrip />
    <slot />
    <Footer />
    <CookieBanner />
  </body>
</html>
